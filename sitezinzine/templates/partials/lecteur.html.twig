<style>
  .lecteur {
    font-family: "Montserrat", sans-serif;
    background-color: black;
    color: white;

    height: 60px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0 20px;

    box-sizing: border-box;
    overflow: hidden;
  }

  .lecteur .gauche {
    padding: 10px;
  }

  .lecteur .direct,
  .lecteur .sousdirect {
    margin: 0;
    padding: 0;
  }

  .lecteur .milieu {
      flex: 1 1 auto;
      min-width: 0;

      display: flex;
      justify-content: center;
      align-items: center;
  }

  .lecteur .droite {
    padding: 10px;

    font-size: 16px;
    font-weight: bold;

    white-space: nowrap;
  }


  /* ============================================================
     LECTEUR AUDIO
     ============================================================ */


  .lecteur .custom-audio-player {
      display: flex;
      align-items: center;
      justify-content: center;

      gap: 12px;

      width: auto;
      max-width: 420px;

      background: black;
  }

  .lecteur #play-pause {
    width: 40px;
    height: 40px;

    flex-shrink: 0;

    border: none;

    background-color: transparent;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;

    cursor: pointer;
  }


  /* ============================================================
     VOLUME
     ============================================================ */

  .lecteur .volume-zone {
      display: flex;
      align-items: center;

      flex: 0 0 auto;

      gap: 8px;
  }

  .lecteur .volume-label {
    flex: 0 0 auto;

    font-size: 11px;
    font-weight: 600;

    white-space: nowrap;

    opacity: 0.8;
  }

  .lecteur #volume-control {
    flex: 0 0 180px;

    width: 180px;
    min-width: 0;

    height: 5px;

    margin: 0;

    -webkit-appearance: none;
    appearance: none;

    background: gray;

    border-radius: 5px;

    cursor: pointer;
  }

  .lecteur #volume-control::-webkit-slider-thumb {
    width: 12px;
    height: 12px;

    -webkit-appearance: none;

    background: white;

    border-radius: 50%;

    cursor: pointer;
  }

  .lecteur #volume-control::-moz-range-thumb {
    width: 12px;
    height: 12px;

    border: none;

    background: white;

    border-radius: 50%;

    cursor: pointer;
  }


  /* ============================================================
     PETIT DESKTOP / TABLETTE
     ============================================================ */

  @media (max-width: 1024px) {

    .lecteur {
      padding: 0 12px;
    }

    .lecteur .droite {
      font-size: 14px;
    }

    .lecteur .custom-audio-player {
      gap: 8px;
    }
  }


  /* ============================================================
     TABLETTE
     ============================================================ */

@media (max-width: 768px) {

  .lecteur {
    display: grid;

    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "gauche droite"
      "milieu milieu";

    align-items: center;

    height: auto;

    padding: 6px 10px;

    column-gap: 10px;
    row-gap: 5px;

    overflow: visible;
  }


  /* =========================
     TEXTE GAUCHE
     ========================= */

  .lecteur .gauche {
    grid-area: gauche;

    width: auto;

    padding: 0;

    text-align: left;
  }

  .lecteur .direct {
    margin: 0;

    font-size: 12px;
    line-height: 1.05;

    white-space: nowrap;
  }

  .lecteur .sousdirect {
    margin: 0;

    font-size: 10px;
    line-height: 1.05;

    white-space: nowrap;

    opacity: .85;
  }


  /* =========================
     SLOGAN DROITE
     ========================= */

  .lecteur .droite {
    grid-area: droite;

    width: auto;

    padding: 0;

    text-align: right;

    font-size: 10px;
    line-height: 1.1;
    font-weight: 700;

    white-space: nowrap;

    opacity: .9;
  }


  /* =========================
     LECTEUR CENTRÉ EN DESSOUS
     ========================= */

  .lecteur .milieu {
    grid-area: milieu;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-width: 0;

    text-align: center;
  }

  .lecteur .custom-audio-player {
    display: flex;
    align-items: center;
    justify-content: center;

    width: min(100%, 320px);

    gap: 8px;
  }

  .lecteur #play-pause {
    flex: 0 0 auto;

    width: 32px;
    height: 32px;
  }

  .lecteur .volume-zone {
    display: flex;
    align-items: center;

    flex: 1 1 auto;

    min-width: 0;

    gap: 7px;
  }

  .lecteur .volume-label {
    flex: 0 0 auto;

    font-size: 9px;

    white-space: nowrap;
  }

  .lecteur #volume-control {
    flex: 1 1 auto;

    width: auto;
    min-width: 0;
    max-width: 180px;
  }
}


  /* ============================================================
     PETIT MOBILE
     ============================================================ */

@media (max-width: 420px) {

  .lecteur {
    padding: 5px 7px;

    column-gap: 6px;
    row-gap: 4px;
  }

  .lecteur .direct {
    font-size: 11px;
  }

  .lecteur .sousdirect {
    font-size: 9px;
  }

  .lecteur .droite {
    font-size: 8px;
  }

  .lecteur .custom-audio-player {
    width: min(100%, 280px);

    gap: 7px;
  }

  .lecteur #play-pause {
    width: 30px;
    height: 30px;
  }

  .lecteur .volume-label {
    font-size: 8px;
  }

  .lecteur #volume-control {
    max-width: 150px;
  }
}


  /* ============================================================
     TRÈS PETIT MOBILE
     ============================================================ */

  @media (max-width: 340px) {

  .lecteur {
    padding: 5px 6px;
  }

  .lecteur .direct {
    font-size: 10px;
  }

  .lecteur .sousdirect {
    font-size: 8px;
  }

  .lecteur .droite {
    font-size: 7px;

    white-space: normal;
  }

  .lecteur .custom-audio-player {
    width: min(100%, 240px);
  }

  .lecteur #play-pause {
    width: 28px;
    height: 28px;
  }

  .lecteur #volume-control {
    max-width: 125px;
  }
}


  /* ============================================================
     MOBILE PAYSAGE
     ============================================================ */

  @media (max-width: 900px) and (orientation: landscape) {

    .lecteur .direct {
      font-size: 12px;
    }

    .lecteur .sousdirect {
      font-size: 11px;
    }

    .lecteur #play-pause {
      width: 34px;
      height: 34px;
    }
  }
</style>


<div class="lecteur">

  <div class="gauche">
    <p class="direct">
      LE DIRECT
    </p>

    <p class="sousdirect">
      Le programme du moment
    </p>
  </div>


  <div class="milieu">

    <div class="custom-audio-player">

      <audio
        id="audio-player"
        src="https://stream.radiozinzine.org:8443/3"
        preload="metadata"
      ></audio>


      <button
        id="play-pause"
        type="button"
        aria-label="Lire ou mettre en pause le direct"
        data-play-icon="/images/lecteur.png"
        data-pause-icon="/images/bouton-pause.png"
      ></button>


      <div class="volume-zone">

        <span class="volume-label">
          Volume
        </span>

        <input
          type="range"
          id="volume-control"
          min="0"
          max="1"
          step="0.01"
          value="1"
          aria-label="Volume du direct"
        >

      </div>

    </div>

  </div>


  <div class="droite">
    RADIO ZINZINE, UNE RADIO LIBRE !
  </div>

</div>


<script>
  document.addEventListener("DOMContentLoaded", function () {

    const audio = document.getElementById("audio-player");
    const playPauseButton = document.getElementById("play-pause");
    const volumeControl = document.getElementById("volume-control");

    if (!audio || !playPauseButton || !volumeControl) {
      return;
    }


    const playIcon =
      playPauseButton.dataset.playIcon;

    const pauseIcon =
      playPauseButton.dataset.pauseIcon;


    function setIcon(isPlaying) {

      playPauseButton.style.backgroundImage =
        `url("${isPlaying ? pauseIcon : playIcon}")`;

    }


    function togglePlayPause() {

      if (audio.paused) {

        audio
          .play()
          .then(() => {
            setIcon(true);
          })
          .catch(() => {
            setIcon(false);
          });

      } else {

        audio.pause();

        setIcon(false);

      }

    }


    /* ============================================================
       ÉTAT INITIAL
       ============================================================ */

    setIcon(false);


    /* ============================================================
       PLAY / PAUSE
       ============================================================ */

    playPauseButton.addEventListener(
      "click",
      togglePlayPause
    );


    /* ============================================================
       VOLUME
       ============================================================ */

    const savedVolume = parseFloat(
      localStorage.getItem("audioVolume") || "1"
    );

    const safeVolume =
      Number.isNaN(savedVolume)
        ? 1
        : Math.min(
            1,
            Math.max(0, savedVolume)
          );


    audio.volume = safeVolume;

    volumeControl.value = safeVolume;


    volumeControl.addEventListener(
      "input",
      function () {

        const volume =
          parseFloat(volumeControl.value);

        audio.volume = volume;

        localStorage.setItem(
          "audioVolume",
          String(volume)
        );

      }
    );


    /* ============================================================
       MÉMORISER L'ÉTAT DE LECTURE
       ============================================================ */

    audio.addEventListener(
      "play",
      function () {

        localStorage.setItem(
          "audioWasPlaying",
          "true"
        );

        setIcon(true);

      }
    );


    audio.addEventListener(
      "pause",
      function () {

        localStorage.setItem(
          "audioWasPlaying",
          "false"
        );

        setIcon(false);

      }
    );


    audio.addEventListener(
      "ended",
      function () {

        localStorage.setItem(
          "audioWasPlaying",
          "false"
        );

        setIcon(false);

      }
    );


    /* ============================================================
       REPRISE AUTOMATIQUE SI LE DIRECT ÉTAIT EN LECTURE
       ============================================================ */

    if (
      localStorage.getItem("audioWasPlaying")
      === "true"
    ) {

      audio
        .play()
        .catch(() => {

          /*
           * Certains navigateurs mobiles interdisent
           * l'autoplay sans interaction utilisateur.
           */
          setIcon(false);

        });

    }

  });
</script>