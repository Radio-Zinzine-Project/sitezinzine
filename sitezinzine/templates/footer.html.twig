<style>
.site-layout > footer {
  background:#1C1C1A;
}

/* ===== Footer – base ===== */
.footer{
  font-family:"Montserrat", sans-serif;
  font-weight:400;
  color:#fff;
  font-size:14px;

  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  align-items:center;

  width:100%;
  max-width:var(--site-chrome-max-width);
  margin-inline:auto;
  padding:12px var(--site-chrome-gutter);
  gap: 6px 12px;
  box-sizing:border-box;
}

.footer a{
  color:#fff;
  text-decoration:none;
}
.footer a:hover{
  color:#E40039;
}

.footer > div{
  margin: 4px 6px;
  white-space: nowrap;
}

/* ===== Mobile portrait : grille compacte ===== */
@media (max-width: 900px){
  .footer{
    padding-inline:var(--site-chrome-mobile-gutter);
  }
}

@media (max-width: 560px){
  .footer{
    display:grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));   /* 👈 2 liens par ligne */
    gap: 6px 12px;
    justify-items:start;
    font-size:13px;
  }

  /* Bloc titre/version en pleine largeur */
  .footer > div:first-child{
    grid-column: 1 / -1;
    text-align:center;
    margin-bottom:6px;
    white-space:normal;
  }

  .footer > div{
    margin: 0;
    white-space: normal;
    overflow-wrap: anywhere;
  }
}

/* ===== Mobile paysage : encore plus condensé ===== */
@media (max-width: 900px) and (orientation: landscape){
  .footer{
    grid-template-columns: repeat(3, minmax(0, 1fr)); /* 👈 3 colonnes en paysage */
    font-size:12.5px;
    gap: 4px 10px;
  }

  .footer > div:first-child{
    grid-column: 1 / -1;
  }
}

</style>
<div class='footer'>
    <div>
        Radio Zinzine Saint Hippolyte F-04300 Limans v1.0.137
    </div>
