        Mentions légales
    </a>
    </div>
    <div>
        <a href="{{ path('amis') }}">
        Sites amis
    </a>
    </div>
    <div>
        <a href="{{ path('aide') }}">
        Aide à l'écoute
    </a>
    </div>
    <div>
        <a href="{{ path('zone') }}">
            Zone d'écoute
        </a>
    </div>
    <div>
    <a href="https://www.radiozinzineaix.org/" target="_blank">
                Radio Zinzine Aix</a>
    </div>
    <div>
        <a href="{{ path('admin.index') }}">
            Admin
        </a>
    </div>
</div>
