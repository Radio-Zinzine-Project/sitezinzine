{% extends 'admin/admin.html.twig' %}

{% block title %}
    Gestion des utilisateurs·rices
{% endblock %}

{% block body %}
<style>
    /* =========================================================
       PAGE
       ========================================================= */

    /*
     * Scope général de la page.
     *
     * Toutes les règles restent sous .users-page afin d'éviter
     * de modifier les autres pages de l'administration.
     */
    .users-page,
    .users-page * {
        box-sizing: border-box;
    }

    .users-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        margin: 0 auto;
        padding: 24px 20px 50px;
        font-family: "Montserrat Alternates", sans-serif;
    }

    .users-page h1 {
        margin: 0 0 20px;
        color: #fff;
        font-size: 28px;
        font-weight: 900;
        line-height: 1.2;
        text-align: center;
        overflow-wrap: anywhere;
    }


    /* =========================================================
       CONTENEUR DE LA TABLE
       ========================================================= */

    .users-table-wrapper {
        width: 95%;
        max-width: 1450px;
        margin: 1rem auto;
        background-color: white;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    /*
     * Liens permettant le tri des colonnes.
     */
    .users-table .sort-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: white;
        font: inherit;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
    }

    .users-table .sort-link:hover {
        color: #E4013A;
    }


    /* =========================================================
       TABLE DESKTOP
       ========================================================= */

    .users-table {
        width: 100%;
        margin: 0;
        padding: 0;
        border-collapse: collapse;
        table-layout: auto;
    }

    .users-table th,
    .users-table td {
        padding: 1rem;
        text-align: left;
        vertical-align: middle;
        border-bottom: 1px solid #ddd;
    }

    .users-table th {
        background-color: #1C1C1A;
        color: white;
        font-weight: 800;
    }

    .users-table tbody tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    .users-table tbody tr:hover {
        background-color: #f5f5f5;
    }

    .users-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================================
       CONTENU DES COLONNES
       ========================================================= */

    /*
     * Les adresses e-mail peuvent être longues.
     * On autorise donc leur retour à la ligne.
     */
    .user-email {
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .user-roles {
        line-height: 1.4;
    }


    /* =========================================================
       ÉTAT DU COMPTE
       ========================================================= */

    /*
     * Un compte peut se trouver dans quatre états visibles :
     *
     * 1. E-mail à confirmer
     *    -> inscription effectuée mais e-mail non vérifié.
     *
     * 2. En attente de validation
     *    -> e-mail vérifié mais compte pas encore approuvé.
     *
     * 3. Compte validé
     *    -> e-mail vérifié + compte approuvé.
     *
     * 4. Compte désactivé
     *    -> soft delete : deletedAt n'est pas null.
     *
     * L'état "désactivé" est prioritaire sur tous les autres.
     */

    .account-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.4rem 0.7rem;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 800;
        line-height: 1.2;
        text-align: center;
    }

    /* E-mail pas encore confirmé. */
    .account-status--email {
        background-color: #f3f3f3;
        color: #555;
        border: 1px solid #ccc;
    }

    /* E-mail confirmé, validation administrative en attente. */
    .account-status--pending {
        background-color: #fff3cd;
        color: #664d03;
        border: 1px solid #ffda6a;
    }

    /* Compte utilisable normalement. */
    .account-status--approved {
        background-color: #d1e7dd;
        color: #0f5132;
        border: 1px solid #a3cfbb;
    }

    /* Compte désactivé par soft delete. */
    .account-status--disabled {
        background-color: #f8d7da;
        color: #842029;
        border: 1px solid #f1aeb5;
    }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .user-actions {
        white-space: nowrap;
    }

    .user-actions-inner {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.5rem;
    }

    .user-actions form {
        margin: 0;
    }


    /* ---------------------------------------------------------
       Bouton d'édition
       --------------------------------------------------------- */

    .btn-edit,
    .btn-approve {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 0.5rem 1rem;
        border-radius: 26px;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition:
            background-color .3s ease,
            color .3s ease,
            border-color .3s ease;
    }

    .btn-edit {
        background-color: white;
        color: black;
        border: 2px solid black;
    }

    .btn-edit:hover {
        background-color: #E40039;
        color: white;
        border-color: #E40039;
    }


    /* ---------------------------------------------------------
       Bouton de validation
       --------------------------------------------------------- */

    /*
     * Ce bouton n'est affiché que lorsque :
     *
     * - l'e-mail est confirmé ;
     * - le compte n'est pas encore approuvé ;
     * - le compte n'est pas désactivé.
     */
    .btn-approve {
        width: 100%;
        background-color: #198754;
        color: white;
        border: 2px solid #198754;
    }

    .btn-approve:hover {
        background-color: #146c43;
        border-color: #146c43;
    }


    /* ---------------------------------------------------------
       Bouton de désactivation
       --------------------------------------------------------- */

    /*
     * L'action admin.user.delete effectue maintenant un soft delete.
     *
     * On parle donc de "désactivation" dans l'interface et non plus
     * de "suppression", puisque le User reste présent en base.
     */
    .btn-deactivate {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 38px;
        padding: 0.45rem 0.8rem;
        background-color: #E4013A;
        color: white;
        border: none;
        border-radius: 26px;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition:
            background-color .2s ease,
            transform .2s ease;
    }

    .btn-deactivate:hover {
        background-color: #b30021;
    }


    /* ---------------------------------------------------------
       Aucune action disponible
       --------------------------------------------------------- */

    .no-action {
        color: #777;
        font-size: 0.85rem;
    }


    /* =========================================================
       TABLETTE
       ========================================================= */

    @media screen and (max-width: 1050px) {
        .users-page {
            padding: 20px 14px 40px;
        }

        .users-table-wrapper {
            width: 100%;
        }

        .users-table th,
        .users-table td {
            padding: 0.8rem 0.7rem;
            font-size: 14px;
        }
    }


    /* =========================================================
       MOBILE
       TABLE -> CARTES
       ========================================================= */

    @media screen and (max-width: 700px) {
        .users-page {
            padding: 18px 10px 32px;
        }

        .users-page h1 {
            margin-bottom: 14px;
            font-size: 23px;
        }

        /*
         * Sur mobile, le conteneur blanc de la table disparaît.
         * Chaque utilisateur devient une carte indépendante.
         */
        .users-table-wrapper {
            width: 100%;
            margin: 0;
            background: transparent;
            border-radius: 0;
            box-shadow: none;
            overflow: visible;
        }

        .users-table,
        .users-table tbody,
        .users-table tr,
        .users-table td {
            display: block;
            width: 100%;
        }

        .users-table thead {
            display: none;
        }

        .users-table tbody {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .users-table tbody tr {
            padding: 8px 12px;
            background: white !important;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.09);
        }

        .users-table tbody tr:hover {
            background: white;
        }

        /*
         * Le libellé de chaque colonne est fourni par data-label
         * directement dans le HTML.
         */
        .users-table td {
            display: grid;
            grid-template-columns:
                minmax(110px, 38%)
                minmax(0, 1fr);
            gap: 10px;
            align-items: center;
            padding: 10px 4px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            text-align: left;
        }

        .users-table td::before {
            content: attr(data-label);
            color: #333;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .users-table td:last-child {
            border-bottom: none;
        }

        .user-email,
        .user-roles {
            min-width: 0;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .user-actions {
            white-space: normal;
        }

        .btn-edit,
        .btn-approve,
        .btn-deactivate {
            width: 100%;
        }

        .btn-deactivate {
            min-height: 40px;
        }
    }


    /* =========================================================
       PETIT MOBILE
       ========================================================= */

    @media screen and (max-width: 450px) {
        .users-page {
            padding: 14px 8px 28px;
        }

        .users-page h1 {
            font-size: 20px;
        }

        .users-table tbody tr {
            padding: 6px 10px;
        }

        .users-table td {
            grid-template-columns: 1fr;
            gap: 5px;
            padding: 9px 2px;
        }

        .users-table td::before {
            font-size: 13px;
        }

        .btn-edit,
        .btn-approve,
        .btn-deactivate {
            min-height: 42px;
        }
    }


    /* =========================================================
       TRÈS PETIT MOBILE
       ========================================================= */

    @media screen and (max-width: 350px) {
        .users-page {
            padding-left: 6px;
            padding-right: 6px;
        }

        .users-page h1 {
            font-size: 18px;
        }

        .users-table td {
            font-size: 13px;
        }
    }


    /* =========================================================
       PAYSAGE À FAIBLE HAUTEUR
       ========================================================= */

    @media screen and (max-height: 520px) and (orientation: landscape) {
        .users-page {
            padding-top: 12px;
        }

        .users-page h1 {
            margin-bottom: 10px;
            font-size: 20px;
        }

        .users-table tbody {
            gap: 10px;
        }

        .users-table tbody tr {
            padding: 5px 10px;
        }

        .users-table td {
            padding: 7px 3px;
        }
    }
</style>

<div class="users-page">
    <h1>
        Gestion des utilisateurices
    </h1>

    <div class="users-table-wrapper">
        <table class="users-table">
            <thead>
                <tr>
                    {# -------------------------------------------------
                       ID
                       ------------------------------------------------- #}
                    <th>
                        <a
                            href="{{ path('admin.user.index', {
                                sort: 'id',
                                direction: sort == 'id' and direction == 'ASC'
                                    ? 'DESC'
                                    : 'ASC'
                            }) }}"
                            class="sort-link"
                        >
                            ID

                            {% if sort == 'id' %}
                                {{ direction == 'ASC' ? '▲' : '▼' }}
                            {% endif %}
                        </a>
                    </th>

                    {# -------------------------------------------------
                       Nom d'utilisateur
                       ------------------------------------------------- #}
                    <th>
                        <a
                            href="{{ path('admin.user.index', {
                                sort: 'username',
                                direction: sort == 'username' and direction == 'ASC'
                                    ? 'DESC'
                                    : 'ASC'
                            }) }}"
                            class="sort-link"
                        >
                            Nom d'utilisateurice

                            {% if sort == 'username' %}
                                {{ direction == 'ASC' ? '▲' : '▼' }}
                            {% endif %}
                        </a>
                    </th>

                    {# -------------------------------------------------
                       Adresse e-mail
                       ------------------------------------------------- #}
                    <th>
                        <a
                            href="{{ path('admin.user.index', {
                                sort: 'email',
                                direction: sort == 'email' and direction == 'ASC'
                                    ? 'DESC'
                                    : 'ASC'
                            }) }}"
                            class="sort-link"
                        >
                            Email

                            {% if sort == 'email' %}
                                {{ direction == 'ASC' ? '▲' : '▼' }}
                            {% endif %}
                        </a>
                    </th>

                    <th>
                        Rôles
                    </th>

                    <th>
                        État du compte
                    </th>

                    <th>
                        Actions
                    </th>

                    {#
                     # La désactivation d'un compte reste réservée
                     # au SUPER_ADMIN, comme l'ancienne action delete.
                     #}
                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                        <th>
                            Désactiver
                        </th>
                    {% endif %}
                </tr>
            </thead>

            <tbody>
                {% for user in users %}
                    <tr>
                        <td data-label="ID">
                            {{ user.id }}
                        </td>

                        <td data-label="Nom d'utilisateurice">
                            {{ user.username }}
                        </td>

                        <td
                            data-label="Email"
                            class="user-email"
                        >
                            {{ user.email }}
                        </td>

                        {# -------------------------------------------------
                           Rôles
                           -------------------------------------------------

                           On conserve l'affichage existant et le mapping
                           available_roles fourni par le contrôleur.
                           ------------------------------------------------- #}
                        <td
                            data-label="Rôles"
                            class="user-roles"
                        >
                            {% for role in user.roles %}
                                {{ available_roles[role]|default(role) }}

                                {% if not loop.last %}
                                    ,
                                {% endif %}
                            {% endfor %}
                        </td>

                        {# -------------------------------------------------
                           État du compte
                           -------------------------------------------------

                           IMPORTANT :
                           deletedAt est prioritaire.

                           Un compte qui avait déjà été vérifié et approuvé
                           avant sa désactivation ne doit pas continuer à
                           apparaître comme "Compte validé".
                           ------------------------------------------------- #}
                        <td data-label="État du compte">
                            {% if user.deleted %}
                                <span class="account-status account-status--disabled">
                                    Compte désactivé
                                </span>

                            {% elseif not user.verified %}
                                <span class="account-status account-status--email">
                                    E-mail à confirmer
                                </span>

                            {% elseif not user.approved %}
                                <span class="account-status account-status--pending">
                                    En attente de validation
                                </span>

                            {% else %}
                                <span class="account-status account-status--approved">
                                    Compte validé
                                </span>
                            {% endif %}
                        </td>

                        {# -------------------------------------------------
                           Actions courantes
                           ------------------------------------------------- #}
                        <td
                            data-label="Actions"
                            class="user-actions"
                        >
                            <div class="user-actions-inner">

                                {#
                                 # L'édition reste disponible comme avant.
                                 # Les restrictions sur les rôles sont
                                 # gérées côté formulaire/contrôleur.
                                 #}
                                <a
                                    href="{{ path('admin.user.edit', {
                                        id: user.id
                                    }) }}"
                                    class="btn-edit"
                                >
                                    Éditer
                                </a>

                                {#
                                 # Validation administrative :
                                 #
                                 # - l'adresse e-mail doit déjà être vérifiée ;
                                 # - le compte ne doit pas encore être approuvé ;
                                 # - un compte désactivé ne doit pas pouvoir
                                 #   être approuvé depuis cette action.
                                 #}
                                {% if
                                    not user.deleted
                                    and user.verified
                                    and not user.approved
                                %}
                                    <form
                                        method="post"
                                        action="{{ path('admin.user.approve', {
                                            id: user.id
                                        }) }}"
                                        onsubmit="return confirm('Valider ce compte utilisateur ?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token(
                                                'approve-user-' ~ user.id
                                            ) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn-approve"
                                        >
                                            Valider le compte
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>

                        {# -------------------------------------------------
                           Désactivation
                           -------------------------------------------------

                           Le nom de route reste admin.user.delete parce que
                           c'est actuellement le nom de l'action Symfony.

                           En revanche, cette action effectue désormais un
                           soft delete. L'interface parle donc correctement
                           de "désactivation" et non de "suppression".

                           Aucun bouton de réactivation n'est ajouté ici :
                           ce comportement n'est pas encore implémenté.
                           ------------------------------------------------- #}
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <td
                                data-label="Désactiver"
                                class="user-actions"
                            >
                                {% if not user.deleted %}
                                    <form
                                        method="post"
                                        action="{{ path('admin.user.delete', {
                                            id: user.id
                                        }) }}"
                                        onsubmit="return confirm('Confirmer la désactivation de ce compte ?');"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token(
                                                'delete-user-' ~ user.id
                                            ) }}"
                                        >

                                        <button
                                            type="submit"
                                            class="btn-deactivate"
                                            aria-label="Désactiver {{ user.username }}"
                                            title="Désactiver le compte"
                                        >
                                            Désactiver
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="no-action">
                                        Compte désactivé
                                    </span>
                                {% endif %}
                            </td>
                        {% endif %}
                    </tr>

                {% else %}
                    <tr>
                        <td
                            colspan="{{ is_granted('ROLE_SUPER_ADMIN') ? 7 : 6 }}"
                            data-label=""
                            style="text-align:center;"
                        >
                            Aucun·e utilisateur·rice.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}