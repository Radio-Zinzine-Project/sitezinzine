{% extends 'admin/admin.html.twig' %}

{% block title 'Éditer l\'évènement ' ~ evenement.titre %}

{% block body %}
<style>
  /* ============================================================
     SCOPE GLOBAL
     Tous les styles restent limités à ce formulaire.
     TinyMCE est volontairement exclu.
     ============================================================ */
  .main-content .event-form,
  .main-content .event-form *:not(.tox):not(.tox *) {
    box-sizing: border-box;
  }

  /* ============================================================
     TINYMCE
     Empêche les styles du formulaire de modifier sa toolbar.
     ============================================================ */
  .main-content .event-form .tox button,
  .main-content .event-form .tox .tox-tbtn,
  .main-content .event-form .tox .tox-mbtn {
    background: initial !important;
    color: inherit !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: initial !important;
    margin: initial !important;
    width: auto !important;
    height: auto !important;
  }

  /* ============================================================
     CONTENEUR PRINCIPAL
     ============================================================ */
  .main-content .event-form {
    font-family: "Montserrat Alternates", sans-serif;
    max-width: 1080px;
    margin: 18px auto 28px;
    padding: 16px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
    color: #1C1C1A;
  }

  .main-content .event-form h1 {
    margin: 0 0 12px;
    text-align: center;
    color: #E4013A;
    font-weight: 900;
    font-size: 22px;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  /* ============================================================
     IMAGE ACTUELLE
     ============================================================ */
  .main-content .event-form .preview {
    display: flex;
    justify-content: center;
    margin: 10px 0 14px;
  }

  .main-content .event-form img.evedit {
    display: block;
    width: min(350px, 100%);
    height: auto;
    border-radius: 10px;
  }

  /* ============================================================
     FORMULAIRE
     ============================================================ */
  .main-content .event-form form {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .main-content .event-form .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
  }

  .main-content .event-form .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
  }

  .main-content .event-form .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
  }

  .main-content .event-form .field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ============================================================
     LABELS ET CHAMPS
     ============================================================ */
  .main-content .event-form label {
    margin: 0 0 6px;
    font-weight: 800;
    color: #333;
    font-size: 14px;
  }

  .main-content .event-form input[type="text"],
  .main-content .event-form input[type="number"],
  .main-content .event-form input[type="date"],
  .main-content .event-form input[type="time"],
  .main-content .event-form input[type="file"],
  .main-content .event-form select,
  .main-content .event-form textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 15px;
    background: #fff;
  }

  .main-content .event-form input[type="file"] {
    padding: 8px 10px;
  }

  .main-content .event-form textarea {
    min-height: 140px;
  }

  .main-content .event-form input:focus,
  .main-content .event-form select:focus,
  .main-content .event-form textarea:focus {
    outline: none;
    border-color: #E4013A;
    box-shadow: 0 0 0 3px rgba(228, 1, 58, 0.15);
  }

  /* ============================================================
     CHECKBOX
     ============================================================ */
  .main-content .event-form .form-check {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 10px 12px;
    margin: 0;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fafafa;
  }

  .main-content .event-form .form-check input[type="checkbox"] {
    width: auto;
    margin: 0;
    flex: 0 0 auto;
  }

  .main-content .event-form .form-check label {
    margin: 0;
  }

  /* ============================================================
     BOUTON PRINCIPAL
     ============================================================ */
  .main-content .event-form button,
  .main-content .event-form input[type="submit"] {
    width: 100%;
    padding: 12px 14px;
    border: 0;
    border-radius: 26px;
    background: #E4013A;
    color: #fff;
    font-weight: 900;
    cursor: pointer;
    transition: background-color .2s ease;
  }

  .main-content .event-form button:hover,
  .main-content .event-form input[type="submit"]:hover {
    background: #b30021;
  }

  /* ============================================================
     TINYMCE
     ============================================================ */
  .main-content .event-form .tinymce-wrap .tox {
    border-radius: 10px;
    overflow: hidden;
  }

  /* ============================================================
     AUTRE TYPE
     ============================================================ */
  .main-content .event-form .other-type {
    min-width: 0;
  }

  /* ============================================================
     ERREURS
     ============================================================ */
  .main-content .event-form .form-error-message,
  .main-content .event-form .error-message {
    margin-top: 5px;
    color: #9f1239;
    font-size: 13px;
    font-weight: 700;
  }

  /* ============================================================
     RESPONSIVE — TABLETTE
     ============================================================ */
  @media (max-width: 960px) {
    .main-content .event-form {
      margin: 14px 12px 22px;
      padding: 14px 12px;
    }

    .main-content .event-form .grid-4,
    .main-content .event-form .grid-3,
    .main-content .event-form .grid-2 {
      grid-template-columns: 1fr;
    }

    .main-content .event-form img.evedit {
      width: min(280px, 100%);
    }
  }

  /* ============================================================
     RESPONSIVE — MOBILE
     ============================================================ */
  @media (max-width: 420px) {
    .main-content .event-form {
      margin: 10px 8px 16px;
      padding: 12px 10px;
      border-radius: 10px;
    }

    .main-content .event-form h1 {
      font-size: 18px;
    }

    .main-content .event-form label {
      font-size: 13px;
    }

    .main-content .event-form input[type="text"],
    .main-content .event-form input[type="number"],
    .main-content .event-form input[type="date"],
    .main-content .event-form input[type="time"],
    .main-content .event-form input[type="file"],
    .main-content .event-form select,
    .main-content .event-form textarea {
      padding: 9px 10px;
      font-size: 14px;
    }

    .main-content .event-form img.evedit {
      width: min(240px, 100%);
    }
  }

  /* ============================================================
     RESPONSIVE — PETIT ÉCRAN PAYSAGE
     ============================================================ */
  @media (max-height: 520px) and (orientation: landscape) {
    .main-content .event-form {
      margin: 10px 12px 14px;
      padding: 12px;
    }

    .main-content .event-form img.evedit {
      width: min(220px, 100%);
    }

    .main-content .event-form textarea {
      min-height: 110px;
    }

    .main-content .event-form button,
    .main-content .event-form input[type="submit"] {
      padding: 10px 12px;
      border-radius: 22px;
    }
  }
</style>


<div class="event-form">

  <h1>Modifier {{ evenement.titre }}</h1>

  {# ============================================================
     IMAGE ACTUELLE
     ============================================================ #}
  {% if evenement.thumbnail %}
    <div class="preview">
      <img
        class="evedit"
        src="{{ vich_uploader_asset(evenement, 'thumbnailFile') }}"
        alt="Photo de {{ evenement.titre }}"
      >
    </div>
  {% endif %}


  {# ============================================================
     FORMULAIRE
     ============================================================ #}
  {{ form_start(form, {
    attr: {
      'data-turbo': 'false'
    }
  }) }}


    {# ==========================================================
       IDENTITÉ
       Titre / Organisateur / Type / Autre type
       ========================================================== #}
    <div class="grid-4">

      <div class="field">
        {{ form_row(form.titre) }}
      </div>

      <div class="field">
        {{ form_row(form.organisateur) }}
      </div>

      <div class="field">
        {{ form_row(form.type) }}
      </div>

      <div
        id="autre-type-wrapper"
        class="field other-type"
        {% if form.autreType.vars.data %}
          style="display:block;"
        {% else %}
          style="display:none;"
        {% endif %}
      >
        {{ form_row(form.autreType) }}
      </div>

    </div>


    {# ==========================================================
       LIEU
       ========================================================== #}
    <div class="grid-3">

      <div class="field">
        {{ form_row(form.ville) }}
      </div>

      <div class="field">
        {{ form_row(form.departement) }}
      </div>

      <div class="field">
        {{ form_row(form.adresse) }}
      </div>

    </div>


    {# ==========================================================
       DATE / HORAIRE / PRIX
       ========================================================== #}
    <div class="grid-4">

      <div class="field">
        {{ form_row(form.dateDebut, {
          attr: {
            'data-controller': 'flatpickr'
          }
        }) }}
      </div>

      <div class="field">
        {{ form_row(form.dateFin, {
          attr: {
            'data-controller': 'flatpickr'
          }
        }) }}
      </div>

      <div class="field">
        {{ form_row(form.horaire) }}
      </div>

      <div class="field">
        {{ form_row(form.prix) }}
      </div>

    </div>


    {# ==========================================================
       PRÉSENTATION
       ========================================================== #}
    <div
      class="tinymce-wrap"
      data-controller="tinymce"
    >
      {{ form_row(form.presentation) }}
    </div>


    {# ==========================================================
       CONTACT
       ========================================================== #}
    <div class="field">
      {{ form_row(form.contact) }}
    </div>


  {{ form_end(form) }}

</div>


<script defer>
  document.addEventListener('DOMContentLoaded', function () {
    const typeSelect = document.getElementById('evenement_type');
    const autreTypeWrapper = document.getElementById('autre-type-wrapper');
    const autreTypeInput = document.getElementById('evenement_autreType');

    /*
     * On conserve volontairement le comportement existant :
     * la valeur "Autre" affiche le champ texte supplémentaire.
     */
    if (!typeSelect || !autreTypeWrapper || !autreTypeInput) {
      return;
    }

    function toggleAutreType() {
      if (typeSelect.value.toLowerCase() === 'autre') {
        autreTypeInput.style.display = 'block';
        autreTypeWrapper.style.display = 'block';
      } else {
        autreTypeWrapper.style.display = 'none';
        autreTypeInput.value = '';
      }
    }

    toggleAutreType();

    typeSelect.addEventListener('change', toggleAutreType);
  });
</script>

{% endblock %}