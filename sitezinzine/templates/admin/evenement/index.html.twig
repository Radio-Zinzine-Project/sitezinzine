{% extends 'admin/admin.html.twig' %}

{% block title %}
    Liste des événements
{% endblock %}

{% block body %}

<style>
/* =========================================================
   PAGE
   ========================================================= */

.evenement-page {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;

    font-family: "Montserrat Alternates", sans-serif;
}

.evenement-page,
.evenement-page *,
.evenement-page *::before,
.evenement-page *::after {
    box-sizing: border-box;
}


/* =========================================================
   BANDEAU ROUGE
   ========================================================= */

.evenement-hero {
    width: 100%;

    background: linear-gradient(
        #E4013A,
        #B81C61
    );

    color: white;
}

.evenement-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;
    max-width: 1200px;

    margin: 0 auto;
    padding: 55px 20px 70px;

    text-align: center;
}

.evenement-hero h1 {
    margin: 0 0 35px;

    color: white;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 36pt;
    font-weight: 900;
    line-height: 1.1;
}

.evenement-hero .btn-create {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: auto;
    min-width: 0;
    min-height: 42px;

    padding: 10px 18px;

    background: white;
    color: #E4013A;

    border: 2px solid white;
    border-radius: 6px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 14px;
    font-weight: 800;

    text-decoration: none;

    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.12);

    transition:
        background-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.evenement-hero .btn-create:hover {
    background: transparent;
    color: white;

    transform: translateY(-2px);
}

.evenement-hero__bottom {
    display: block;

    width: 100%;
    height: auto;

    margin: 0;
    padding: 0;
}


/* =========================================================
   CONTENU BLANC
   ========================================================= */

.evenement-content-wrapper {
    width: 100%;

    padding: 30px 20px 50px;

    background: white;
}


/* =========================================================
   LISTE
   ========================================================= */

.evenement-list {
    display: flex;
    flex-direction: column;

    gap: 20px;

    width: 100%;
    max-width: 1200px;

    margin: 0 auto;
    padding: 0;
}


/* =========================================================
   CARTE
   ========================================================= */

.evenement-card {
    display: grid;

    grid-template-columns:
        170px
        minmax(0, 1fr)
        140px;

    gap: 20px;
    align-items: center;

    width: 100%;

    margin: 0;
    padding: 20px;

    background: white;
    color: #1C1C1A;

    border: 1px solid #eeeeee;
    border-radius: 15px;

    box-shadow:
        0 4px 15px
        rgba(0, 0, 0, 0.10);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
}

.evenement-card:hover {
    transform: translateY(-5px);

    border-color: #f3c2ce;

    box-shadow:
        0 10px 24px
        rgba(0, 0, 0, 0.15);
}


/* Carte sans image :
   on supprime complètement la colonne image */

.evenement-card--no-image {
    grid-template-columns:
        minmax(0, 1fr)
        140px;
}


/* =========================================================
   ÉVÉNEMENT NON VALIDÉ
   ========================================================= */

.evenement-card--inactive {
    background: #ededed;

    border: 2px dashed #888;

    box-shadow:
        0 3px 10px
        rgba(0, 0, 0, 0.06);
}

.evenement-card--inactive:hover {
    border-color: #666;

    box-shadow:
        0 8px 20px
        rgba(0, 0, 0, 0.12);
}

.evenement-card--inactive .evenement-title a {
    color: #666;
}

.evenement-card--inactive .evenement-presentation {
    color: #666;
}


/* =========================================================
   IMAGE
   ========================================================= */

.evenement-image {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-width: 0;
}

.evenement-image img {
    display: block;

    width: 150px;
    height: 150px;

    object-fit: cover;

    border-radius: 10px;

    box-shadow:
        0 4px 8px
        rgba(0, 0, 0, 0.1);
}


/* =========================================================
   CONTENU
   ========================================================= */

.evenement-main {
    min-width: 0;
}

.evenement-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: 7px;

    margin-bottom: 8px;
}

.evenement-type,
.evenement-status {
    display: inline-flex;
    align-items: center;

    padding: 4px 9px;

    border-radius: 5px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.3px;
}

.evenement-type {
    background: #E4013A;
    color: white;
}

.evenement-status {
    background: #555;
    color: white;
}

.evenement-title {
    margin: 0 0 10px;
}

.evenement-title a {
    display: block;

    padding: 0;

    color: #E4013A;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 20px;
    font-weight: 700;

    line-height: 1.3;

    text-decoration: none;

    overflow-wrap: anywhere;
    word-break: break-word;

    transition: color 0.2s ease;
}

.evenement-title a:hover {
    color: #B81C61;
}


/* =========================================================
   INFORMATIONS
   ========================================================= */

.evenement-infos {
    display: flex;
    flex-wrap: wrap;

    gap: 6px 18px;

    margin-bottom: 12px;

    color: #555;

    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    line-height: 1.4;
}

.evenement-info {
    min-width: 0;

    overflow-wrap: anywhere;
}

.evenement-info strong {
    color: #333;
    font-weight: 700;
}


/* =========================================================
   PRÉSENTATION
   ========================================================= */

.evenement-presentation {
    color: #333;

    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    line-height: 1.5;

    overflow-wrap: anywhere;
    word-break: break-word;

    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;

    overflow: hidden;
}

.evenement-presentation p:first-child {
    margin-top: 0;
}

.evenement-presentation p:last-child {
    margin-bottom: 0;
}


/* =========================================================
   ACTIONS
   ========================================================= */

.evenement-actions {
    display: flex;
    flex-direction: column;

    gap: 12px;

    width: 100%;
    min-width: 0;
}

.evenement-actions form {
    display: block;

    width: 100%;

    margin: 0;
    padding: 0;
}

.evenement-actions > a,
.evenement-actions > form > button {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-width: 100%;
    max-width: 100%;

    height: 44px;

    margin: 0;
    padding: 8px 12px;

    border: none;
    border-radius: 8px;

    box-shadow:
        0 4px 8px
        rgba(0, 0, 0, 0.1);

    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 600;

    line-height: 1;
    text-align: center;
    text-decoration: none;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        opacity 0.2s ease;
}

.evenement-actions > a {
    background: #666;
    color: white;
}

.evenement-actions .btn-validation {
    background: #E4013A;
    color: white;
}

.evenement-actions .btn-delete {
    background: #B81C61;
    color: white;
}

.evenement-actions > a:hover,
.evenement-actions > form > button:hover {
    transform: translateY(-2px);

    opacity: 0.95;

    color: white;
}


/* =========================================================
   LISTE VIDE
   ========================================================= */

.evenement-empty {
    width: 100%;

    margin: 0;
    padding: 35px 20px;

    background: #f7f7f7;
    color: #555;

    border: 1px solid #eeeeee;
    border-radius: 15px;

    font-family: "Montserrat", sans-serif;
    font-size: 15px;

    text-align: center;
}


/* =========================================================
   TABLETTE
   ========================================================= */

@media screen and (max-width: 900px) {

    .evenement-hero__content {
        padding:
            45px
            20px
            60px;
    }

    .evenement-hero h1 {
        margin-bottom: 25px;

        font-size: 32px;
    }

    .evenement-card {
        grid-template-columns:
            140px
            minmax(0, 1fr);

        align-items: start;
    }

    .evenement-card--no-image {
        grid-template-columns: minmax(0, 1fr);
    }

    .evenement-image img {
        width: 130px;
        height: 130px;
    }

    .evenement-actions {
        grid-column: 1 / -1;

        flex-direction: row;
        justify-content: flex-end;

        gap: 10px;
    }

    .evenement-card--no-image .evenement-actions {
        grid-column: 1;
    }

    .evenement-actions > a,
    .evenement-actions > form {
        width: 150px;
    }

    .evenement-actions > form > button {
        width: 100%;
    }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

    .evenement-content-wrapper {
        padding:
            22px
            12px
            40px;
    }

    .evenement-hero__content {
        padding:
            38px
            15px
            52px;
    }

    .evenement-hero h1 {
        margin-bottom: 22px;

        font-size: 28px;
    }

    .evenement-hero .btn-create {
        max-width: 100%;

        padding: 10px 14px;

        font-size: 13px;
    }

    .evenement-card,
    .evenement-card--no-image {
        grid-template-columns: 1fr;

        gap: 16px;

        padding: 16px;
    }

    .evenement-image {
        justify-content: flex-start;
    }

    .evenement-image img {
        width: 120px;
        height: 120px;
    }

    .evenement-actions,
    .evenement-card--no-image .evenement-actions {
        grid-column: auto;

        display: grid;
        grid-template-columns: 1fr 1fr;

        gap: 8px;
    }

    .evenement-actions > a,
    .evenement-actions > form {
        width: 100%;
    }

    .evenement-actions > form:last-child {
        grid-column: 1 / -1;
    }

    .evenement-actions > a,
    .evenement-actions > form > button {
        min-width: 0;

        height: 42px;

        padding: 7px 9px;

        font-size: 13px;
    }
}


/* =========================================================
   TRÈS PETIT ÉCRAN
   ========================================================= */

@media screen and (max-width: 400px) {

    .evenement-hero h1 {
        font-size: 25px;
    }

    .evenement-card,
    .evenement-card--no-image {
        padding: 14px;
    }

    .evenement-title a {
        font-size: 18px;
    }

    .evenement-infos {
        flex-direction: column;

        gap: 4px;
    }

    .evenement-actions,
    .evenement-card--no-image .evenement-actions {
        display: flex;
        flex-direction: column;
    }

    .evenement-actions > a,
    .evenement-actions > form {
        width: 100%;
    }
}


/* =========================================================
   PETITE HAUTEUR / PAYSAGE
   ========================================================= */

@media screen and (max-height: 500px) and (orientation: landscape) {

    .evenement-hero__content {
        padding:
            25px
            20px
            38px;
    }

    .evenement-hero h1 {
        margin-bottom: 18px;

        font-size: 28px;
    }
}
</style>


<div class="evenement-page">

    {# =========================================================
       BANDEAU ROUGE
       ========================================================= #}

    <div class="evenement-hero">

        <div class="evenement-hero__content">

            <h1>
                Liste des événements
            </h1>

            <a
                class="btn-create"
                href="{{ path('admin.evenement.create') }}"
            >
                Créer un nouvel événement
            </a>

        </div>

        <img
            class="evenement-hero__bottom"
            src="/images/top-content-dechire-D.gif"
            alt=""
        >

    </div>


    {# =========================================================
       ZONE BLANCHE
       ========================================================= #}

    <div class="evenement-content-wrapper">

        <article class="evenement-list">

            {% for evenement in evenements %}

                <section class="
                    evenement-card
                    {{ not evenement.thumbnail ? 'evenement-card--no-image' : '' }}
                    {{ not evenement.valid ? 'evenement-card--inactive' : '' }}
                ">

                    {# =================================================
                       IMAGE
                       ================================================= #}

                    {% if evenement.thumbnail %}

                        <div class="evenement-image">

                            <img
                                src="{{ vich_uploader_asset(
                                    evenement,
                                    'thumbnailFile'
                                ) }}"
                                alt="Photo de {{ evenement.titre }}"
                            >

                        </div>

                    {% endif %}


                    {# =================================================
                       CONTENU
                       ================================================= #}

                    <div class="evenement-main">

                        <div class="evenement-badges">

                            {% if evenement.type %}

                                <span class="evenement-type">
                                    {{ evenement.type }}
                                </span>

                            {% endif %}

                            {% if not evenement.valid %}

                                <span class="evenement-status">
                                    NON VALIDÉ
                                </span>

                            {% endif %}

                        </div>


                        <h2 class="evenement-title">

                            <a
                                href="{{ path(
                                    'admin.evenement.show',
                                    {
                                        id: evenement.id
                                    }
                                ) }}"
                            >
                                {{ evenement.titre }}
                            </a>

                        </h2>


                        <div class="evenement-infos">

                            {% if evenement.organisateur %}

                                <div class="evenement-info">

                                    <strong>
                                        Organisateur :
                                    </strong>

                                    {{ evenement.organisateur }}

                                </div>

                            {% endif %}


                            {% if evenement.ville or evenement.departement %}

                                <div class="evenement-info">

                                    <strong>
                                        Lieu :
                                    </strong>

                                    {% if evenement.ville %}
                                        {{ evenement.ville }}
                                    {% endif %}

                                    {% if evenement.departement %}

                                        {% if evenement.ville %}
                                            —
                                        {% endif %}

                                        {{ evenement.departement }}

                                    {% endif %}

                                </div>

                            {% endif %}


                            <div class="evenement-info">

                                <strong>
                                    Date :
                                </strong>

                                {{ evenement.dateDebut|date('d/m/Y') }}

                                {% if evenement.dateFin %}

                                    {% if evenement.dateFin|date('Y-m-d') != evenement.dateDebut|date('Y-m-d') %}

                                        au
                                        {{ evenement.dateFin|date('d/m/Y') }}

                                    {% endif %}

                                {% endif %}

                            </div>


                            {% if evenement.horaire %}

                                <div class="evenement-info">

                                    <strong>
                                        Horaire :
                                    </strong>

                                    {{ evenement.horaire }}

                                </div>

                            {% endif %}

                        </div>


                        {% if evenement.presentation %}

                            <div class="evenement-presentation">
                                {{ evenement.presentation|raw }}
                            </div>

                        {% endif %}

                    </div>


                    {# =================================================
                       ACTIONS
                       ================================================= #}

                    <div class="evenement-actions">

                        <a
                            href="#"
                            data-controller="return"
                            data-return-url-value="{{ path(
                                'admin.evenement.edit',
                                {
                                    id: evenement.id
                                }
                            ) }}"
                            data-action="click->return#redirectWithReturnTo"
                        >
                            Éditer
                        </a>


                        {% if evenement.valid %}

                            <form
                                action="{{ path(
                                    'admin.evenement.unvalid',
                                    {
                                        id: evenement.id
                                    }
                                ) }}"
                                method="post"
                            >

                                <button
                                    type="submit"
                                    class="btn-validation"
                                >
                                    Dévalider
                                </button>

                            </form>

                        {% else %}

                            <form
                                action="{{ path(
                                    'admin.evenement.valid',
                                    {
                                        id: evenement.id
                                    }
                                ) }}"
                                method="post"
                            >

                                <button
                                    type="submit"
                                    class="btn-validation"
                                >
                                    Valider
                                </button>

                            </form>

                        {% endif %}


                        <form
                            action="{{ path(
                                'admin.evenement.softDelete',
                                {
                                    id: evenement.id
                                }
                            ) }}"
                            method="post"
                        >

                            <input
                                type="hidden"
                                name="_method"
                                value="DELETE"
                            >

                            <button
                                type="submit"
                                class="btn-delete"
                            >
                                Supprimer
                            </button>

                        </form>

                    </div>

                </section>

            {% else %}

                <div class="evenement-empty">
                    Aucun événement à afficher.
                </div>

            {% endfor %}

        </article>

    </div>

</div>

{% endblock %}