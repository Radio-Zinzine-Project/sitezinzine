{% extends 'admin/admin.html.twig' %}
{% block title %}
    Validation des annonces auditeurices
{% endblock %}
{% block body %}
    <style>
/* =========================================================
   PAGE
   ========================================================= */

.annonce-page,
.annonce-page * {
    box-sizing: border-box;
}

.annonce-page {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    font-family: "Montserrat Alternates", sans-serif;

    overflow-x: clip;
}


/* =========================================================
   BANDEAU ROUGE
   ========================================================= */

.annonce-hero {
    width: 100%;

    background: linear-gradient(
        #E4013A,
        #B81C61
    );

    color: white;
}

.annonce-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;
    max-width: 1200px;

    margin: 0 auto;
    padding: 55px 20px 70px;

    text-align: center;
}

.annonce-hero h1 {
    margin: 0;

    color: white;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 36pt;
    font-weight: 900;
    line-height: 1.1;
}


/* IMPORTANT :
   sélecteur volontairement précis pour ne pas être écrasé
   par la règle globale .annonce-hero img
*/

.annonce-hero img.annonce-hero__bottom {
    display: block;

    width: 100%;
    height: auto;

    margin: 0;
}


/* =========================================================
   CONTENU BLANC
   ========================================================= */

.annonce-content-wrapper {
    width: 100%;
    max-width: 100%;
    min-width: 0;

    padding: 25px 20px 50px;

    background: white;
}


/* =========================================================
   LISTE
   ========================================================= */

.annonce-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 24px;

    width: 100%;
    max-width: 1400px;
    min-width: 0;

    margin: 0 auto;
    padding: 0;
}


/* =========================================================
   CARTE
   ========================================================= */

.annonce-card {
    display: grid;

    grid-template-columns:
        150px
        minmax(0, 1fr);

    grid-template-rows:
        1fr
        auto;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    margin: 0;

    background: white;
    color: #1C1C1A;

    border: 1px solid #eeeeee;
    border-radius: 15px;

    overflow: hidden;

    box-shadow:
        0 4px 15px
        rgba(0, 0, 0, 0.10);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
}

.annonce-card:hover {
    transform: translateY(-4px);

    border-color: #f3c2ce;

    box-shadow:
        0 10px 24px
        rgba(0, 0, 0, 0.15);
}


/* =========================================================
   CARTE SANS IMAGE
   ========================================================= */

.annonce-card.annonce-card--no-image {
    grid-template-columns: minmax(0, 1fr);
}


/* =========================================================
   ANNONCE NON VALIDÉE
   ========================================================= */

.annonce-card--pending {
    background: #f3f3f3;

    border: 2px dashed #999;
}

.annonce-card--pending:hover {
    border-color: #777;
}


/* =========================================================
   IMAGE
   ========================================================= */

.annonce-image {
    grid-column: 1;
    grid-row: 1;

    width: 150px;
    min-width: 0;
    min-height: 100%;

    background: #f2eef5;

    overflow: hidden;
}

.annonce-image img {
    display: block;

    width: 100%;
    height: 100%;
    min-height: 220px;

    object-fit: cover;
}


/* =========================================================
   CONTENU
   ========================================================= */

.annonce-main {
    grid-row: 1;

    width: 100%;
    min-width: 0;

    padding: 20px 22px;
}

.annonce-card:not(.annonce-card--no-image) .annonce-main {
    grid-column: 2;
}

.annonce-card--no-image .annonce-main {
    grid-column: 1;
}

/* =========================================================
   LIGNE TYPE / STATUT
   ========================================================= */

.annonce-card__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    width: 100%;
    min-width: 0;

    margin: 0 0 12px;
}


/* =========================================================
   STATUT
   ========================================================= */

.annonce-status {
    display: inline-flex;
    align-items: center;

    min-height: 26px;

    margin: 0;
    padding: 5px 9px;

    border-radius: 5px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.4px;
}

.annonce-status--pending {
    background: #555;
    color: white;
}

.annonce-status--valid {
    background: #E4013A;
    color: white;
}


/* =========================================================
   TYPE
   ========================================================= */

.annonce-type {
    display: inline-flex;
    align-items: center;

    max-width: 100%;
    min-height: 28px;

    margin: 0;
    padding: 5px 10px;

    background: #f5edf8;
    color: #7E4093;

    border-radius: 999px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;

    overflow-wrap: anywhere;
}


/* =========================================================
   TITRE
   ========================================================= */

.annonce-card .annonce-title {
    width: 100%;

    margin: 0 0 12px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.3;
}

.annonce-card .annonce-title a {
    display: block;

    width: 100%;
    min-width: 0;

    margin: 0;
    padding: 0;

    color: #E4013A;

    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;

    text-decoration: none;

    overflow-wrap: anywhere;
    word-break: break-word;

    transition: color 0.2s ease;
}

.annonce-card .annonce-title a:hover {
    color: #B81C61;
}


/* =========================================================
   INFORMATIONS
   ========================================================= */

.annonce-meta {
    width: 100%;
    min-width: 0;

    margin: 0 0 7px;

    color: #555;

    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    line-height: 1.4;

    overflow-wrap: anywhere;
    word-break: break-word;
}

.annonce-meta strong {
    color: #333;
}

.annonce-dates {
    width: 100%;
    min-width: 0;

    margin: 0 0 14px;

    color: #7E4093;

    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;

    overflow-wrap: anywhere;
    word-break: break-word;
}


/* =========================================================
   PRÉSENTATION
   ========================================================= */

.annonce-presentation {
    display: -webkit-box;

    width: 100%;
    min-width: 0;

    color: #444;

    font-family: "Montserrat", sans-serif;
    font-size: 14px;
    line-height: 1.5;

    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;

    overflow: hidden;

    overflow-wrap: anywhere;
    word-break: break-word;
}

.annonce-presentation p:first-child {
    margin-top: 0;
}

.annonce-presentation p:last-child {
    margin-bottom: 0;
}


/* =========================================================
   ACTIONS
   ========================================================= */

.annonce-actions {
    grid-column: 1 / -1;
    grid-row: 2;

    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;

    gap: 8px;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    margin: 0;
    padding: 14px 12px;

    background: #fafafa;

    border-top: 1px solid #eeeeee;
}

.annonce-card--pending .annonce-actions {
    background: #e9e9e9;
    border-top-color: #d4d4d4;
}

.annonce-actions form {
    display: block;

    width: 100px;
    min-width: 0;

    margin: 0;
    padding: 0;
}

.annonce-actions > a,
.annonce-actions > form > button {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100px;
    min-width: 0;
    height: 42px;

    margin: 0;
    padding: 8px;

    border: none;
    border-radius: 7px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;

    text-align: center;
    text-decoration: none;

    white-space: nowrap;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        opacity 0.2s ease;
}

.annonce-actions > a:hover,
.annonce-actions > form > button:hover {
    transform: translateY(-2px);

    opacity: 0.92;

    color: white;
}

.annonce-action--show {
    background: #666;
    color: white;
}

.annonce-action--edit {
    background: #7E4093;
    color: white;
}

.annonce-action--validate {
    background: #E4013A;
    color: white;
}

.annonce-action--unvalidate {
    background: #555;
    color: white;
}

.annonce-action--delete {
    background: #1C1C1A;
    color: white;
}


/* =========================================================
   LISTE VIDE
   ========================================================= */

.annonce-empty {
    grid-column: 1 / -1;

    width: 100%;

    margin: 20px auto;
    padding: 35px 20px;

    background: #f8f8f8;
    color: #555;

    border: 1px solid #eeeeee;
    border-radius: 15px;

    font-family: "Montserrat", sans-serif;
    font-size: 15px;

    text-align: center;
}


/* =========================================================
   PAGINATION
   ========================================================= */

.annonce-pagination {
    display: flex;
    justify-content: center;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    margin: 18px auto 28px;
}

.annonce-pagination .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;

    gap: 5px;

    max-width: 100%;

    margin: 0;
    padding: 0;

    background: transparent;
}

.annonce-pagination .pagination span {
    display: inline-flex;
}

.annonce-pagination .pagination a,
.annonce-pagination .pagination .current {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 32px;
    height: 32px;

    padding: 0 8px;

    border: 1px solid #E4013A;
    border-radius: 6px;

    background: white;
    color: #E4013A;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 12px;
    font-weight: 700;

    text-decoration: none;

    transition:
        background-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.annonce-pagination .pagination a:hover {
    background: #E4013A;
    color: white;

    transform: translateY(-2px);
}

.annonce-pagination .pagination .current {
    background: #E4013A;
    color: white;

    font-weight: 900;
}

.annonce-pagination .pagination .disabled {
    opacity: 0.4;
}


/* =========================================================
   ÉCRANS INTERMÉDIAIRES
   ========================================================= */

@media screen and (max-width: 1200px) {

    .annonce-list {
        grid-template-columns: minmax(0, 1fr);

        max-width: 1000px;
    }

    .annonce-card {
        grid-template-columns:
            170px
            minmax(0, 1fr);
    }

    .annonce-card.annonce-card--no-image {
        grid-template-columns: minmax(0, 1fr);
    }

    .annonce-image {
        width: 170px;
    }
}


/* =========================================================
   TABLETTE
   ========================================================= */

@media screen and (max-width: 768px) {

    .annonce-hero__content {
        padding:
            45px
            20px
            60px;
    }

    .annonce-hero h1 {
        font-size: 32px;
    }

    .annonce-content-wrapper {
        padding:
            25px
            16px
            45px;
    }

    .annonce-card {
        grid-template-columns:
            130px
            minmax(0, 1fr);
    }

    .annonce-card.annonce-card--no-image {
        grid-template-columns: minmax(0, 1fr);
    }

    .annonce-image {
        width: 130px;
    }

    .annonce-image img {
        min-height: 190px;
    }

    .annonce-main {
        padding: 17px;
    }

    .annonce-card .annonce-title {
        font-size: 16px;
    }

    .annonce-actions {
        justify-content: center;
    }

    .annonce-pagination .pagination {
        gap: 4px;
    }

    .annonce-pagination .pagination a,
    .annonce-pagination .pagination .current {
        min-width: 30px;
        height: 30px;

        padding: 0 6px;

        font-size: 11px;
    }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 560px) {

    .annonce-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
    }

    .annonce-hero__content {
        padding:
            38px
            14px
            52px;
    }

    .annonce-hero h1 {
        font-size: 28px;
    }

    .annonce-content-wrapper {
        width: 100%;
        max-width: 100%;
        min-width: 0;

        padding:
            22px
            12px
            40px;
    }

    .annonce-list {
        grid-template-columns: minmax(0, 1fr);

        width: 100%;
        max-width: 100%;
        min-width: 0;

        gap: 16px;

        margin: 0;
    }

    .annonce-card,
    .annonce-card.annonce-card--no-image {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto auto auto;

        width: 100%;
        max-width: 100%;
        min-width: 0;
    }


    /* IMAGE */

    .annonce-card .annonce-image {
        grid-column: 1;
        grid-row: 1;

        width: 100%;
        max-width: 100%;
        height: 180px;
    }

    .annonce-card .annonce-image img {
        width: 100%;
        height: 180px;
        min-height: 0;

        object-fit: cover;
    }
    
    .annonce-card__topline {
        gap: 8px;
    }

    .annonce-type,
    .annonce-status {
        max-width: calc(50% - 4px);
    }

    .annonce-type {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .annonce-status {
        flex: 0 0 auto;
        white-space: nowrap;
    }

    /* CONTENU */

    .annonce-card .annonce-main,
    .annonce-card:not(.annonce-card--no-image) .annonce-main,
    .annonce-card.annonce-card--no-image .annonce-main {
        grid-column: 1;
        grid-row: 2;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        padding: 16px;
    }

    .annonce-card .annonce-title {
        font-size: 15px;
    }


    /* ACTIONS */

    .annonce-card .annonce-actions {
        grid-column: 1;
        grid-row: 3;

        display: grid;

        grid-template-columns:
            minmax(0, 1fr)
            minmax(0, 1fr);

        gap: 8px;

        width: 100%;
        max-width: 100%;
        min-width: 0;

        padding: 12px;
    }

    .annonce-card .annonce-actions > a,
    .annonce-card .annonce-actions > form {
        width: 100%;
        max-width: 100%;
        min-width: 0;

        margin: 0;
    }

    .annonce-card .annonce-actions > a,
    .annonce-card .annonce-actions > form > button {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        height: 42px;

        margin: 0;
        padding: 8px;
    }


    /* PAGINATION */

    .annonce-pagination {
        width: 100%;
        max-width: 100%;

        padding: 0 2px;
    }

    .annonce-pagination .pagination {
        width: 100%;
        max-width: 100%;

        justify-content: center;

        gap: 4px;
    }
}


/* =========================================================
   TRÈS PETIT MOBILE
   ========================================================= */

@media screen and (max-width: 380px) {

    .annonce-hero__content {
        padding-left: 10px;
        padding-right: 10px;
    }

    .annonce-hero h1 {
        font-size: 25px;
    }

    .annonce-content-wrapper {
        padding-left: 10px;
        padding-right: 10px;
    }

    .annonce-card .annonce-actions {
        grid-template-columns: minmax(0, 1fr);
    }

    .annonce-card .annonce-actions > a,
    .annonce-card .annonce-actions > form,
    .annonce-card .annonce-actions > form > button {
        width: 100%;
        max-width: 100%;
        min-width: 0;
    }
}

</style>
    <div class="annonce-page">
        {# =========================================================
            BANDEAU ROUGE
        ========================================================= #}
        <div class="annonce-hero">
            <div class="annonce-hero__content">
                <h1>
                    Validation des annonces
                </h1>
            </div>
            <img class="annonce-hero__bottom" src="/images/top-content-dechire-D.gif" alt=""></div>
            {# =========================================================
                ZONE BLANCHE
            ========================================================= #}
            <div class="annonce-content-wrapper">
                {% if annonces.pageCount > 1 %}
                    <div class="annonce-pagination">
                        {{ knp_pagination_render(annonces) }}
                    </div>
                {% endif %}
                <article class="annonce-list">
                    {% for annonce in annonces %}
                        <section class="
                                annonce-card
                                {{ not annonce.thumbnail
                                ? 'annonce-card--no-image'
                                : '' }}
                                {{ not annonce.valid
                                ? 'annonce-card--pending'
                                : '' }}
                            ">
                            {# =================================================
                                IMAGE
                            ================================================= #}
                            {% if annonce.thumbnail %}
                                <div class="annonce-image">
                                    <img src="{{ vich_uploader_asset(
                                    annonce,
                                    'thumbnailFile'
                                ) }}" alt="Photo de {{ annonce.titre }}"></div>
                                {% endif %}
                                {# =================================================
                                    CONTENU
                                ================================================= #}
                                <div class="annonce-main">
                                    <div class="annonce-card__topline">
                                        <div class="annonce-type">
                                            {{ annonce.type }}
                                        </div>
                                        {% if annonce.valid %}
                                            <div class="annonce-status annonce-status--valid">
                                                VALIDÉE
                                            </div>
                                        {% else %}
                                            <div class="annonce-status annonce-status--pending">
                                                À VALIDER
                                            </div>
                                        {% endif %}
                                    </div>
                                    <h2 class="annonce-title">
                                        <a href="{{ path(
                                'admin.annonce.show',
                                {
                                    id: annonce.id
                                }
                            ) }}">
                                            {{ annonce.titre }}
                                        </a>
                                    </h2>
                                    <div class="annonce-meta">
                                        {% if annonce.organisateur %}
                                            <strong>
                                                {{ annonce.organisateur }}
                                            </strong>
                                        {% endif %}
                                        {% if annonce.ville %}
                                            {% if annonce.organisateur %}
                                                ·
                                            {% endif %}
                                            {{ annonce.ville }}
                                            {% if annonce.departement %}
                                                (
                                                {{ annonce.departement }}
                                                )
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                    <div class="annonce-dates">
                                        {% if annonce.dateDebut %}
                                            {% if
                                    annonce.dateFin
                                    and
                                    annonce.dateDebut|date('Y-m-d')
                                    !=
                                    annonce.dateFin|date('Y-m-d') %}
                                                Du
                                                {{ annonce.dateDebut|date('d/m/Y') }}
                                                au
                                                {{ annonce.dateFin|date('d/m/Y') }}
                                            {% else %}
                                                {{ annonce.dateDebut|date('d/m/Y') }}
                                            {% endif %}
                                        {% endif %}
                                        {% if annonce.horaire %}
                                            {% if annonce.dateDebut %}
                                                ·
                                            {% endif %}
                                            {{ annonce.horaire }}
                                        {% endif %}
                                    </div>
                                    {% if annonce.presentation %}
                                        <div class="annonce-presentation">
                                            {{ annonce.presentation|raw }}
                                        </div>
                                    {% endif %}
                                </div>
                                {# =================================================
                                    ACTIONS
                                ================================================= #}
                                <div class="annonce-actions">
                                    <a class="annonce-action--show" href="{{ path(
                                'admin.annonce.show',
                                {
                                    id: annonce.id
                                }
                            ) }}">
                                        Voir
                                    </a>
                                    <a class="annonce-action--edit" href="{{ path(
                                'admin.annonce.edit',
                                {
                                    id: annonce.id
                                }
                            ) }}" data-controller="return" data-return-url-value="{{ path(
                                'admin.annonce.edit',
                                {
                                    id: annonce.id
                                }
                            ) }}" data-action="
                                            click->return#redirectWithReturnTo
                                        ">
                                        Éditer
                                    </a>
                                    {% if annonce.valid %}
                                        <form action="{{ path(
                                    'admin.annonce.unvalid',
                                    {
                                        id: annonce.id
                                    }
                                ) }}" method="post">
                                            <button type="submit" class="
                                                    annonce-action--unvalidate
                                                ">
                                                Dévalider
                                            </button>
                                        </form>
                                    {% else %}
                                        <form action="{{ path(
                                    'admin.annonce.valid',
                                    {
                                        id: annonce.id
                                    }
                                ) }}" method="post">
                                            <button type="submit" class="
                                                    annonce-action--validate
                                                ">
                                                Valider
                                            </button>
                                        </form>
                                    {% endif %}
                                    <form action="{{ path(
                                'admin.annonce.softDelete',
                                {
                                    id: annonce.id
                                }
                            ) }}" method="post" data-controller="return" data-action="
                                            submit->return#confirmBeforeSubmit
                                            submit->return#redirectWithReturnTo
                                        ">
                                        <input type="hidden" name="_method" value="DELETE">
                                            <input type="hidden" name="_token" value="{{ csrf_token(
                                    'delete' ~ annonce.id
                                ) }}">
                                                <button type="submit" class="annonce-action--delete">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>
                                    </section>
                                {% else %}
                                    <div class="annonce-empty">
                                        Aucune annonce à afficher.
                                    </div>
                                {% endfor %}
                            </article>
                            {% if annonces.pageCount > 1 %}
                                <div class="annonce-pagination">
                                    {{ knp_pagination_render(annonces) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endblock %}
                