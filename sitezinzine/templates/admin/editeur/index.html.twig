{% extends 'admin/admin.html.twig' %}

{% block title %}
    Tous les éditeurs !
{% endblock %}

{% block body %}

<style>
/* =========================================================
   PAGE
   ========================================================= */

.admin-editeur-page {
    width: 100%;
    max-width: 100%;

    overflow-x: hidden;

    background: white;

    font-family: "Montserrat Alternates", sans-serif;
}

.admin-editeur-page,
.admin-editeur-page *,
.admin-editeur-page *::before,
.admin-editeur-page *::after {
    box-sizing: border-box;
}


/* =========================================================
   BANDEAU ROUGE
   ========================================================= */

.admin-editeur-page .editeur-hero {
    width: 100%;

    background: linear-gradient(
        #E4013A,
        #B81C61
    );

    color: white;
}

.admin-editeur-page .editeur-hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    width: 100%;
    max-width: 1200px;

    margin: 0 auto;
    padding: 55px 20px 70px;

    text-align: center;
}

.admin-editeur-page .editeur-hero h1 {
    margin: 0 0 30px;

    color: white;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 36pt;
    font-weight: 900;
    line-height: 1.1;
}


/* =========================================================
   BOUTON CRÉATION
   ========================================================= */

.admin-editeur-page .btn-create {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;

    padding: 10px 18px;

    background: white;
    color: #E4013A;

    border: 2px solid white;
    border-radius: 6px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 14px;
    font-weight: 800;

    text-decoration: none;

    box-shadow: 0 4px 8px rgba(0, 0, 0, .12);

    transition:
        background-color .2s ease,
        color .2s ease,
        transform .2s ease;
}

.admin-editeur-page .btn-create:hover {
    background: transparent;
    color: white;

    transform: translateY(-2px);
}


/* =========================================================
   DÉCHIRURE
   ========================================================= */

.admin-editeur-page .editeur-hero__bottom {
    display: block;

    width: 100%;
    height: auto;

    margin: 0;
}


/* =========================================================
   PARTIE BLANCHE
   ========================================================= */

.admin-editeur-page .editeur-content {
    width: 100%;

    min-height: calc(100vh - 300px);

    padding: 30px 20px 50px;

    background: white;
}


/* =========================================================
   LISTE
   ========================================================= */

.admin-editeur-page .editeur-list {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 18px;

    width: 100%;
    max-width: 1200px;

    margin: 0 auto;
    padding: 0;
}


/* =========================================================
   CARTE
   ========================================================= */

.admin-editeur-page .editeur-card {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        auto;

    align-items: center;

    gap: 16px;

    width: 100%;
    min-width: 0;

    padding: 18px 20px;

    background: white;
    color: #1C1C1A;

    border: 1px solid #eeeeee;
    border-radius: 15px;

    box-shadow:
        0 4px 15px
        rgba(0, 0, 0, .10);

    transition:
        transform .3s ease,
        box-shadow .3s ease,
        border-color .3s ease;
}

.admin-editeur-page .editeur-card:hover {
    transform: translateY(-4px);

    border-color: #f3c2ce;

    box-shadow:
        0 10px 24px
        rgba(0, 0, 0, .15);
}


/* =========================================================
   NOM
   ========================================================= */

.admin-editeur-page .editeur-card__content {
    min-width: 0;
}

.admin-editeur-page .editeur-card__title {
    margin: 0;
}

.admin-editeur-page .editeur-card__title a {
    display: block;

    color: #E4013A;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.3;

    text-decoration: none;

    overflow-wrap: anywhere;
    word-break: break-word;

    transition: color .2s ease;
}

.admin-editeur-page .editeur-card__title a:hover {
    color: #B81C61;
}


/* =========================================================
   ACTION
   ========================================================= */

.admin-editeur-page .editeur-card__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    min-width: 0;
}

.admin-editeur-page .btn-edit {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 100px;
    min-height: 38px;

    padding: 7px 14px;

    background: #666;
    color: white;

    border: none;
    border-radius: 8px;

    box-shadow:
        0 4px 8px
        rgba(0, 0, 0, .10);

    font-family: "Montserrat", sans-serif;
    font-size: 13px;
    font-weight: 600;

    text-align: center;
    text-decoration: none;

    transition:
        transform .2s ease,
        background-color .2s ease;
}

.admin-editeur-page .btn-edit:hover {
    background: #E4013A;
    color: white;

    transform: translateY(-2px);
}


/* =========================================================
   LISTE VIDE
   ========================================================= */

.admin-editeur-page .editeur-empty {
    grid-column: 1 / -1;

    width: 100%;

    margin: 20px 0;
    padding: 30px 20px;

    color: #666;

    background: #f7f7f7;

    border-radius: 12px;

    font-family: "Montserrat", sans-serif;

    text-align: center;
}


/* =========================================================
   TABLETTE
   ========================================================= */

@media screen and (max-width: 900px) {

    .admin-editeur-page .editeur-hero__content {
        padding: 45px 20px 60px;
    }

    .admin-editeur-page .editeur-hero h1 {
        margin-bottom: 25px;

        font-size: 32px;
    }

    .admin-editeur-page .editeur-list {
        grid-template-columns: 1fr;
    }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

    .admin-editeur-page .editeur-hero__content {
        padding: 30px 14px 42px;
    }

    .admin-editeur-page .editeur-hero h1 {
        margin-bottom: 20px;

        font-size: 26px;
        line-height: 1.15;
    }

    .admin-editeur-page .btn-create {
        max-width: 100%;

        padding: 9px 14px;

        font-size: 13px;

        text-align: center;
    }

    .admin-editeur-page .editeur-content {
        padding: 20px 10px 40px;
    }

    .admin-editeur-page .editeur-list {
        gap: 12px;
    }

    .admin-editeur-page .editeur-card {
        gap: 10px;

        padding: 14px;

        border-radius: 12px;
    }

    .admin-editeur-page .editeur-card:hover {
        transform: none;
    }

    .admin-editeur-page .editeur-card__title a {
        font-size: 17px;
    }

    .admin-editeur-page .btn-edit {
        min-width: 90px;
        min-height: 36px;

        padding: 6px 12px;

        font-size: 12px;
    }
}


/* =========================================================
   PETIT MOBILE
   ========================================================= */

@media screen and (max-width: 420px) {

    .admin-editeur-page .editeur-hero__content {
        padding: 24px 10px 36px;
    }

    .admin-editeur-page .editeur-hero h1 {
        font-size: 23px;
    }

    .admin-editeur-page .btn-create {
        width: 100%;
    }

    .admin-editeur-page .editeur-content {
        padding-left: 8px;
        padding-right: 8px;
    }

    .admin-editeur-page .editeur-card {
        grid-template-columns:
            minmax(0, 1fr)
            auto;

        gap: 8px;

        padding: 12px;
    }

    .admin-editeur-page .editeur-card__title a {
        font-size: 16px;
    }

    .admin-editeur-page .btn-edit {
        min-width: 82px;
        min-height: 34px;

        padding: 5px 9px;

        font-size: 11.5px;
    }
}


/* =========================================================
   TRÈS PETIT MOBILE
   ========================================================= */

@media screen and (max-width: 350px) {

    .admin-editeur-page .editeur-content {
        padding-left: 6px;
        padding-right: 6px;
    }

    .admin-editeur-page .editeur-card {
        padding: 10px;

        gap: 6px;
    }

    .admin-editeur-page .editeur-card__title a {
        font-size: 15px;
    }

    .admin-editeur-page .btn-edit {
        min-width: 72px;

        padding-left: 7px;
        padding-right: 7px;

        font-size: 11px;
    }
}


/* =========================================================
   MOBILE PAYSAGE
   ========================================================= */

@media screen and (max-height: 500px) and (orientation: landscape) {

    .admin-editeur-page .editeur-hero__content {
        padding-top: 20px;
        padding-bottom: 32px;
    }

    .admin-editeur-page .editeur-hero h1 {
        margin-bottom: 14px;

        font-size: 24px;
    }

    .admin-editeur-page .editeur-content {
        padding-top: 14px;
    }
}
</style>


<div class="admin-editeur-page">

    <header class="editeur-hero">

        <div class="editeur-hero__content">

            <h1>
                Liste des éditeurs
            </h1>

            <a
                class="btn-create"
                href="{{ path('admin.editeur.create') }}"
            >
                Créer un nouvel éditeur
            </a>

        </div>

        <img
            class="editeur-hero__bottom"
            src="/images/top-content-dechire-D.gif"
            alt=""
        >

    </header>


    <main class="editeur-content">

        <article class="editeur-list">

            {% for editeur in editeurs %}

                <section class="editeur-card">

                    <div class="editeur-card__content">

                        <h2 class="editeur-card__title">

                            <a
                                href="{{ path(
                                    'admin.editeur.show',
                                    {
                                        id: editeur.id
                                    }
                                ) }}"
                            >
                                {{ editeur.name }}
                            </a>

                        </h2>

                    </div>


                    <div class="editeur-card__actions">

                        <a
                            class="btn-edit"
                            href="{{ path(
                                'admin.editeur.edit',
                                {
                                    id: editeur.id
                                }
                            ) }}"
                            data-controller="return"
                            data-return-url-value="{{ path(
                                'admin.editeur.edit',
                                {
                                    id: editeur.id
                                }
                            ) }}"
                            data-action="click->return#redirectWithReturnTo"
                        >
                            Éditer
                        </a>

                    </div>

                </section>

            {% else %}

                <p class="editeur-empty">
                    Aucun éditeur disponible.
                </p>

            {% endfor %}

        </article>

    </main>

</div>

{% endblock %}