{% extends 'admin/admin.html.twig' %}

{% block title %}
    Éditer l'éditeur {{ editeur.name }}
{% endblock %}

{% block body %}

<style>
/* =========================================================
   SCOPE
   ========================================================= */

.main-content .editeur-form,
.main-content .editeur-form * {
    box-sizing: border-box;
}


/* =========================================================
   CARTE
   ========================================================= */

.main-content .editeur-form {
    width: calc(100% - 32px);
    max-width: 1080px;

    margin: 18px auto 28px;
    padding: 16px;

    background: #fff;
    color: #1C1C1A;

    border-radius: 12px;

    box-shadow:
        0 6px 18px
        rgba(0, 0, 0, .08);

    font-family: "Montserrat Alternates", sans-serif;
}


/* =========================================================
   TITRE
   ========================================================= */

.main-content .editeur-form h1 {
    margin: 0 0 18px;

    color: #E4013A;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 22px;
    font-weight: 900;
    line-height: 1.2;

    text-align: center;

    overflow-wrap: anywhere;
}


/* =========================================================
   FORMULAIRE
   ========================================================= */

.main-content .editeur-form form {
    display: flex;
    flex-direction: column;

    gap: 12px;

    width: 100%;

    margin: 0;
    padding: 0;
}

.main-content .editeur-form form > div {
    width: 100%;
    min-width: 0;
}


/* =========================================================
   LABELS
   ========================================================= */

.main-content .editeur-form label {
    display: block;

    margin: 0 0 6px;

    color: #333;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 14px;
    font-weight: 800;
}


/* =========================================================
   CHAMPS
   ========================================================= */

.main-content .editeur-form input[type="text"],
.main-content .editeur-form input[type="number"],
.main-content .editeur-form input[type="email"],
.main-content .editeur-form input[type="tel"],
.main-content .editeur-form input[type="url"],
.main-content .editeur-form input[type="file"],
.main-content .editeur-form select,
.main-content .editeur-form textarea {
    display: block;

    width: 100%;
    max-width: 100%;

    margin: 0;
    padding: 10px 12px;

    background: #fff;
    color: #1C1C1A;

    border: 1px solid #ddd;
    border-radius: 8px;

    font-family: "Montserrat", sans-serif;
    font-size: 15px;
}

.main-content .editeur-form input[type="file"] {
    padding: 8px 10px;
}

.main-content .editeur-form textarea {
    min-height: 140px;

    resize: vertical;
}


/* =========================================================
   FOCUS
   ========================================================= */

.main-content .editeur-form input[type="text"]:focus,
.main-content .editeur-form input[type="number"]:focus,
.main-content .editeur-form input[type="email"]:focus,
.main-content .editeur-form input[type="tel"]:focus,
.main-content .editeur-form input[type="url"]:focus,
.main-content .editeur-form input[type="file"]:focus,
.main-content .editeur-form select:focus,
.main-content .editeur-form textarea:focus {
    outline: none;

    border-color: #E4013A;

    box-shadow:
        0 0 0 3px
        rgba(228, 1, 58, .15);
}


/* =========================================================
   CHECKBOX / RADIO
   ========================================================= */

.main-content .editeur-form input[type="checkbox"],
.main-content .editeur-form input[type="radio"] {
    width: 18px;
    height: 18px;

    margin: 0 8px 0 0;

    accent-color: #E4013A;
}

.main-content .editeur-form form > div:has(> input[type="checkbox"]) {
    display: flex;
    align-items: center;

    min-height: 44px;

    padding: 10px 12px;

    background: #fafafa;

    border: 1px solid #ddd;
    border-radius: 10px;
}

.main-content .editeur-form form > div:has(> input[type="checkbox"]) label {
    display: inline;

    margin: 0;
}


/* =========================================================
   SELECT MULTIPLE
   ========================================================= */

.main-content .editeur-form select[multiple] {
    min-height: 150px;
}


/* =========================================================
   ERREURS
   ========================================================= */

.main-content .editeur-form .form-error-message,
.main-content .editeur-form .invalid-feedback,
.main-content .editeur-form ul {
    color: #E4013A;

    font-family: "Montserrat", sans-serif;
    font-size: 13px;
}

.main-content .editeur-form ul {
    margin: 5px 0 0;

    padding-left: 20px;
}


/* =========================================================
   SUBMIT
   ========================================================= */

.main-content .editeur-form button[type="submit"],
.main-content .editeur-form input[type="submit"] {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;

    margin-top: 4px;
    padding: 12px 14px;

    background: #E4013A;
    color: #fff;

    border: 0;
    border-radius: 26px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 15px;
    font-weight: 900;

    text-align: center;

    cursor: pointer;

    transition:
        background-color .2s ease,
        transform .2s ease;
}

.main-content .editeur-form button[type="submit"]:hover,
.main-content .editeur-form input[type="submit"]:hover {
    background: #b30021;

    transform: translateY(-1px);
}


/* =========================================================
   TABLETTE
   ========================================================= */

@media screen and (max-width: 960px) {

    .main-content .editeur-form {
        width: auto;

        margin: 14px 12px 22px;
        padding: 14px 12px;
    }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

    .main-content .editeur-form {
        margin-left: 10px;
        margin-right: 10px;
    }

    .main-content .editeur-form h1 {
        font-size: 20px;
    }

    .main-content .editeur-form textarea {
        min-height: 120px;
    }

    .main-content .editeur-form select[multiple] {
        min-height: 135px;
    }
}


/* =========================================================
   PETIT MOBILE
   ========================================================= */

@media screen and (max-width: 420px) {

    .main-content .editeur-form {
        margin: 10px 8px 16px;
        padding: 12px 10px;

        border-radius: 10px;
    }

    .main-content .editeur-form h1 {
        font-size: 18px;
    }

    .main-content .editeur-form label {
        font-size: 13px;
    }

    .main-content .editeur-form input[type="text"],
    .main-content .editeur-form input[type="number"],
    .main-content .editeur-form input[type="email"],
    .main-content .editeur-form input[type="tel"],
    .main-content .editeur-form input[type="url"],
    .main-content .editeur-form input[type="file"],
    .main-content .editeur-form select,
    .main-content .editeur-form textarea {
        padding: 9px 10px;

        font-size: 14px;
    }

    .main-content .editeur-form select[multiple] {
        min-height: 125px;
    }

    .main-content .editeur-form button[type="submit"],
    .main-content .editeur-form input[type="submit"] {
        padding: 11px 12px;

        font-size: 14px;
    }
}


/* =========================================================
   TRÈS PETIT MOBILE
   ========================================================= */

@media screen and (max-width: 350px) {

    .main-content .editeur-form {
        margin-left: 6px;
        margin-right: 6px;

        padding-left: 8px;
        padding-right: 8px;
    }
}


/* =========================================================
   MOBILE PAYSAGE
   ========================================================= */

@media screen and (max-height: 520px) and (orientation: landscape) {

    .main-content .editeur-form {
        margin: 10px 12px 14px;
        padding: 12px;
    }

    .main-content .editeur-form textarea {
        min-height: 110px;
    }

    .main-content .editeur-form select[multiple] {
        min-height: 120px;
    }

    .main-content .editeur-form button[type="submit"],
    .main-content .editeur-form input[type="submit"] {
        padding: 10px 12px;

        border-radius: 22px;
    }
}
</style>


<div class="editeur-form">

    <h1>
        Modifier {{ editeur.name }}
    </h1>

    {{ form_start(form, {
        attr: {
            'data-turbo': 'false'
        }
    }) }}

    {{ form_widget(form) }}

    {{ form_end(form) }}

</div>

{% endblock %}