{% extends 'admin/admin.html.twig' %}
{% block title %}Catégorie : {{ categorie.titre }}{% endblock %}

{% block body %}
<style>
  /* ✅ Spécifique admin : force full-width malgré le padding du layout */
  /* ====== Layout global ====== */
  .catblock,
  .catblock *{
    box-sizing: border-box;
  }

  .catblock{
    background: linear-gradient(#E4013A, #B81C61);
    width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    font-family: "Montserrat Alternates", sans-serif;
    font-weight: 700;
    font-style: normal;
    color: white;
    line-height: 1.5em;
  }

  .top img{
    width: 100%;
    display: block;
  }

  /* ====== Fiche catégorie ====== */
  .fiche-emission{
    margin-block: 2rem;
    background-color: #fff;
    color: #1C1C1A;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    padding: 1.5rem;
    font-family: "Montserrat Alternates", sans-serif;
  }

  .bloc-haut{
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .bloc-image img{
    width: 200px;
    border-radius: 6px;
    object-fit: cover;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .bloc-texte{
    flex: 1;
    min-width: 0;
  }

  .bloc-texte h1{
    font-size: 1.6rem;
    margin-bottom: 1rem;
    color: #E40039;
    overflow-wrap: anywhere;
  }

  .descriptif{
    font-size: 1rem;
    line-height: 1.6;
    margin: 15px;
    overflow-wrap: anywhere;
  }

  .btn-back{
    display: inline-block;
    margin-bottom: 1rem;
    color: #E40039;
    font-weight: bold;
    text-decoration: none;
  }

  .btn-back:hover{
    text-decoration: underline;
  }

  .bottom img{
    width: 100%;
    display: block;
    margin: 0;
    padding: 0;
  }

  /* ====== Section émissions (fond blanc sans “double wrapper”) ====== */
  .emissionsdelacategorie{
    background: #fff;
    color: #1C1C1A;
    padding: 24px 0 10px;
  }

  .emissionsdelacategorie .emission-list .invites,
  .emissionsdelacategorie .emission-list .cat {
    overflow-wrap: anywhere;
  }

  .emissionsdelacategorie .results{
    background: transparent;
    padding: 0;
  }

  .emissionsdelacategorie > .results > .results-inner{
    box-sizing: border-box;
    max-width: var(--admin-width-list);
    padding-inline: var(--admin-list-gutter);
  }

  .more-link{
    text-align: center;
    padding: 0 16px 24px;
    font-family: "Montserrat", sans-serif;
  }

  .more-link a{
    color: #E40039;
    font-weight: 800;
    text-decoration: none;
  }

  .more-link a:hover{
    color: #000;
  }

  /* ====== Responsive ====== */
  @media (max-width: 768px){
    .fiche-emission{
      padding: 1rem;
      margin-block: 1rem;
    }

    .bloc-haut{
      flex-direction: column;
      align-items: center;
    }

    .bloc-image img{
      width: min(320px, 100%);
    }

    .bloc-texte{
      text-align: center;
    }

    .bloc-texte .descriptif{
      text-align: left;
      font-size: 0.95rem;
      line-height: 1.55;
      margin: 12px 0;
    }

    .bloc-texte h1{
      font-size: 1.3rem;
    }
  }
</style>

<div>
  <div class="catblock">
    <div class="admin-content-gutters">
    <div class="fiche-emission admin-content-container">
      <a href="{{ app.request.headers.get('referer') ?? path('admin.categorie.index') }}" class="btn-back">← Retour</a>

      <div class="bloc-haut">
        <div class="bloc-image">
          {% if categorie.thumbnail %}
            <img src="{{ vich_uploader_asset(categorie, 'thumbnailFile') }}" alt="Image de la catégorie {{ categorie.titre }}">
          {% else %}
            <img src="/images/emission-zinzine.jpg" alt="Image par défaut">
          {% endif %}
        </div>

        <div class="bloc-texte">
          <h1>{{ categorie.titre }}</h1>
          <div class="descriptif">
            {{ categorie.descriptif | raw }}
          </div>
        </div>
      </div>
    </div>
    </div>
    <div class="bottom">
      <img src="/images/top-content-dechire-D.gif" alt="">
    </div>
  </div>

  <div class="emissionsdelacategorie">
    {% include 'partials/_emission_results.html.twig' with {
      emissions: emissions,
      showNoResults: true,
      resultsTitle: 'Toutes les émissions de cette catégorie :',
      noResultsText: 'Aucune émission trouvée dans cette catégorie.',
      useKnpPagination: true,
      useLivePagination: false,
      searchTerm: null
    } only %}

    <div class="more-link">
      <a href="{{ path('admin.emission.index') }}">Voir toutes les émissions (admin)</a>
    </div>
  </div>
</div>
{% endblock %}
