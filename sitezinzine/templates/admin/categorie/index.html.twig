{% extends 'admin/admin.html.twig' %}
{% block title %}
    Toutes les catégories !
{% endblock %}
{% block body %}
    <style>
        /* =========================================================
           PAGE
           ========================================================= */

        .categorie-page {
            width: 100%;
            max-width: 100%;
            overflow-x: hidden;
            font-family: "Montserrat Alternates", sans-serif;
        }

        .categorie-page,
        .categorie-page *,
        .categorie-page *::before,
        .categorie-page *::after {
            box-sizing: border-box;
        }


        /* =========================================================
           BANDEAU ROUGE
           ========================================================= */

        .categorie-hero {
            width: 100%;

            background: linear-gradient(
                #E4013A,
                #B81C61
            );

            color: white;
        }

        .categorie-hero__content {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;

            width: 100%;
            max-width: 1200px;

            margin: 0 auto;
            padding: 55px 20px 70px;

            text-align: center;
        }

        .categorie-hero h1 {
            margin: 0 0 35px;

            color: white;

            font-family: "Montserrat Alternates", sans-serif;
            font-size: 36pt;
            font-weight: 900;
            line-height: 1.1;
        }

        .categorie-hero .btn-create {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            width: auto;
            min-width: 0;
            min-height: 42px;

            padding: 10px 18px;

            background: white;
            color: #E4013A;

            border: 2px solid white;
            border-radius: 6px;

            font-family: "Montserrat Alternates", sans-serif;
            font-size: 14px;
            font-weight: 800;

            text-decoration: none;

            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.12);

            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .categorie-hero .btn-create:hover {
            background: transparent;
            color: white;

            transform: translateY(-2px);
        }

        .categorie-hero__bottom {
            display: block;

            width: 100%;
            height: auto;

            margin: 0;
        }


        /* =========================================================
           CONTENU BLANC
           ========================================================= */

        .categorie-content-wrapper {
            width: 100%;

            padding: 25px 20px 50px;

            background: white;
        }


        /* =========================================================
           PAGINATION ALPHABÉTIQUE
           ========================================================= */

        .alphabet-pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;

            gap: 4px;

            width: 100%;
            max-width: 1200px;

            margin: 0 auto 22px;
            padding: 0;
        }

        .alphabet-pagination a {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            box-sizing: border-box;

            width: 30px;
            min-width: 30px;
            height: 30px;

            padding: 0;

            background: white;
            color: #E4013A;

            border: 2px solid #E4013A;
            border-radius: 6px;

            font-family: "Montserrat Alternates", sans-serif;
            font-size: 12px;
            font-weight: 800;

            text-decoration: none;

            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .alphabet-pagination a:first-child {
            width: auto;
            min-width: 42px;
            padding: 0 7px;
        }

        .alphabet-pagination a:last-child {
            width: auto;
            min-width: 58px;
            padding: 0 9px;
        }

        .alphabet-pagination a:hover {
            background: #E4013A;
            color: white;
            transform: translateY(-2px);
        }

        .alphabet-pagination a.active {
            background: #E4013A;
            color: white;
        }


        /* =========================================================
           PAGINATION KNP
           ========================================================= */

        .knp-pagination {
            display: flex;
            justify-content: center;

            width: 100%;

            margin: 18px auto 28px;
        }

        .knp-pagination .pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;

            gap: 5px;

            margin: 0;
            padding: 0;

            background: transparent;
        }

        .knp-pagination .pagination span {
            display: inline-flex;
        }

        .knp-pagination .pagination a,
        .knp-pagination .pagination .current {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            min-width: 32px;
            height: 32px;

            padding: 0 8px;

            box-sizing: border-box;

            border: 1px solid #E4013A;
            border-radius: 6px;

            background: white;
            color: #E4013A;

            font-family: "Montserrat Alternates", sans-serif;
            font-size: 12px;
            font-weight: 700;

            text-decoration: none;

            transition:
                background-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .knp-pagination .pagination a:hover {
            background: #E4013A;
            color: white;

            transform: translateY(-2px);
        }

        .knp-pagination .pagination .current {
            background: #E4013A;
            color: white;

            font-weight: 900;
        }

        .knp-pagination .pagination .disabled {
            opacity: 0.4;
        }


        /* =========================================================
           LISTE
           ========================================================= */

        .categorie-list {
            display: flex;
            flex-direction: column;

            gap: 20px;

            width: 100%;
            max-width: 1200px;

            margin: 0 auto;
            padding: 0;
        }


        /* =========================================================
           CARTE
           ========================================================= */

        .categorie-card {
            display: grid;

            grid-template-columns:
                170px
                minmax(0, 1fr)
                120px
                130px;

            gap: 20px;
            align-items: center;

            width: 100%;

            margin: 0;
            padding: 20px;

            background: white;
            color: #1C1C1A;

            border: 1px solid #eeeeee;
            border-radius: 15px;

            box-sizing: border-box;

            box-shadow:
                0 4px 15px
                rgba(0, 0, 0, 0.10);

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;
        }

        .categorie-card:hover {
            transform: translateY(-5px);

            border-color: #f3c2ce;

            box-shadow:
                0 10px 24px
                rgba(0, 0, 0, 0.15);
        }


        /* =========================================================
           CATÉGORIE INACTIVE
           ========================================================= */

        .categorie-card--inactive {
            background: #ededed;

            border: 2px dashed #888;

            box-shadow:
                0 3px 10px
                rgba(0, 0, 0, 0.06);
        }

        .categorie-card--inactive:hover {
            border-color: #666;

            box-shadow:
                0 8px 20px
                rgba(0, 0, 0, 0.12);
        }

        .categorie-card--inactive .categorie-title a {
            color: #666;
        }

        .categorie-card--inactive .categorie-description {
            color: #666;
        }

        .categorie-status {
            display: inline-flex;
            align-items: center;

            margin-bottom: 8px;
            padding: 4px 9px;

            background: #555;
            color: white;

            border-radius: 5px;

            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.5px;
        }


        /* =========================================================
           IMAGE
           ========================================================= */

        .categorie-image {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
        }

        .categorie-image img {
            display: block;

            width: 150px;
            height: 150px;

            object-fit: cover;

            border-radius: 10px;

            box-shadow:
                0 4px 8px
                rgba(0, 0, 0, 0.1);
        }


        /* =========================================================
           CONTENU
           ========================================================= */

        .categorie-main {
            min-width: 0;
        }

        .categorie-title {
            margin: 0 0 10px;
        }

        .categorie-title a {
            display: block;

            padding: 0;

            color: #E4013A;

            font-family: "Montserrat Alternates", sans-serif;
            font-size: 20px;
            font-weight: 700;

            line-height: 1.3;

            text-decoration: none;

            overflow-wrap: anywhere;
            word-break: break-word;

            transition: color 0.2s ease;
        }

        .categorie-title a:hover {
            color: #B81C61;
        }

        .categorie-description {
            color: #333;

            font-family: "Montserrat", sans-serif;
            font-size: 15px;
            line-height: 1.5;

            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .categorie-description p:first-child {
            margin-top: 0;
        }

        .categorie-description p:last-child {
            margin-bottom: 0;
        }


        /* =========================================================
           COMPTEUR
           ========================================================= */

        .categorie-count {
            display: flex;
            align-items: center;
            justify-content: center;

            min-width: 0;

            color: #555;

            font-family: "Montserrat", sans-serif;
            font-size: 14px;
            font-weight: 700;

            text-align: center;
        }


        /* =========================================================
           ACTIONS
           ========================================================= */

        .categorie-actions {
            display: flex;
            flex-direction: column;

            gap: 12px;

            width: 100%;
            min-width: 0;
        }

        .categorie-actions form {
            display: block;

            width: 100%;

            margin: 0;
            padding: 0;
        }

        .categorie-actions > a,
        .categorie-actions > form > button {
            display: flex;
            align-items: center;
            justify-content: center;

            width: 100%;
            min-width: 100%;
            max-width: 100%;

            height: 44px;

            margin: 0;
            padding: 8px 12px;

            box-sizing: border-box;

            border: none;
            border-radius: 8px;

            box-shadow:
                0 4px 8px
                rgba(0, 0, 0, 0.1);

            font-family: "Montserrat", sans-serif;
            font-size: 14px;
            font-weight: 600;

            line-height: 1;
            text-align: center;
            text-decoration: none;

            cursor: pointer;

            transition:
                transform 0.2s ease,
                opacity 0.2s ease;
        }

        .categorie-actions > a {
            background: #666;
            color: white;
        }

        .categorie-actions > form > button {
            background: #E4013A;
            color: white;
        }

        .categorie-actions > a:hover,
        .categorie-actions > form > button:hover {
            transform: translateY(-2px);

            opacity: 0.95;

            color: white;
        }

    /* =========================================================
    TABLETTE
    ========================================================= */

    @media screen and (max-width: 900px) {

        .categorie-hero__content {
            padding: 42px 20px 55px;
        }

        .categorie-hero h1 {
            margin-bottom: 25px;
            font-size: 32px;
        }

        .categorie-content-wrapper {
            padding-left: 16px;
            padding-right: 16px;
        }

        .categorie-list {
            gap: 16px;
        }

        .categorie-card {
            grid-template-columns:
                140px
                minmax(0, 1fr);

            gap: 16px;

            padding: 16px;
        }

        .categorie-image {
            grid-column: 1;
            grid-row: 1 / span 2;
        }

        .categorie-image img {
            width: 130px;
            height: 130px;
        }

        .categorie-main {
            grid-column: 2;
            grid-row: 1;
        }

        .categorie-count {
            grid-column: 2;
            grid-row: 2;

            justify-content: flex-start;

            text-align: left;
        }

        .categorie-actions {
            grid-column: 1 / -1;

            flex-direction: row;
            justify-content: flex-end;

            gap: 10px;
        }

        .categorie-actions > a,
        .categorie-actions > form {
            width: 150px;
        }

        .categorie-actions > form > button {
            width: 100%;
        }
    }


    /* =========================================================
    MOBILE
    ========================================================= */

    @media screen and (max-width: 600px) {

        /* ---------------------------------------------------------
        Bandeau
        --------------------------------------------------------- */

        .categorie-hero__content {
            padding: 30px 14px 42px;
        }

        .categorie-hero h1 {
            margin-bottom: 20px;

            font-size: 26px;
            line-height: 1.15;
        }

        .categorie-hero .btn-create {
            max-width: 100%;

            padding: 9px 14px;

            font-size: 13px;

            text-align: center;
        }


        /* ---------------------------------------------------------
        Zone blanche
        --------------------------------------------------------- */

        .categorie-content-wrapper {
            padding: 18px 10px 40px;
        }


        /* ---------------------------------------------------------
        Pagination alphabétique
        --------------------------------------------------------- */

        .alphabet-pagination {
            gap: 4px;

            margin-bottom: 16px;
        }

        .alphabet-pagination a {
            width: 30px;
            min-width: 30px;
            height: 30px;

            padding: 0;

            font-size: 12px;
        }

        .alphabet-pagination a:first-child {
            width: auto;
            min-width: 42px;

            padding: 0 7px;
        }

        .alphabet-pagination a:last-child {
            width: auto;
            min-width: 56px;

            padding: 0 8px;
        }


        /* ---------------------------------------------------------
        Pagination KNP
        --------------------------------------------------------- */

        .knp-pagination {
            margin: 14px auto 20px;
        }

        .knp-pagination .pagination {
            gap: 4px;

            max-width: 100%;
        }

        .knp-pagination .pagination a,
        .knp-pagination .pagination .current {
            min-width: 30px;
            height: 30px;

            padding: 0 6px;

            font-size: 11px;
        }


        /* ---------------------------------------------------------
        Liste
        --------------------------------------------------------- */

        .categorie-list {
            gap: 12px;
        }


        /* ---------------------------------------------------------
        Carte
        --------------------------------------------------------- */

        .categorie-card {
            grid-template-columns:
                100px
                minmax(0, 1fr);

            gap: 10px 14px;

            padding: 12px;

            border-radius: 12px;
        }

        .categorie-card:hover {
            transform: none;
        }


        /* Image */

        .categorie-image {
            grid-column: 1;
            grid-row: 1 / span 2;

            align-self: start;
        }

        .categorie-image img {
            width: 90px;
            height: 90px;

            border-radius: 8px;
        }


        /* Contenu */

        .categorie-main {
            grid-column: 2;
            grid-row: 1;

            min-width: 0;
        }

        .categorie-title {
            margin-bottom: 6px;
        }

        .categorie-title a {
            font-size: 17px;
            line-height: 1.25;
        }

        .categorie-status {
            margin-bottom: 6px;

            padding: 3px 7px;

            font-size: 10px;
        }

        .categorie-description {
            font-size: 13px;
            line-height: 1.4;

            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .categorie-description img,
        .categorie-description iframe,
        .categorie-description video,
        .categorie-description table {
            max-width: 100%;
        }


        /* Compteur */

        .categorie-count {
            grid-column: 2;
            grid-row: 2;

            align-self: end;

            justify-content: flex-start;

            font-size: 12px;
            text-align: left;
        }


        /* Actions */

        .categorie-actions {
            grid-column: 1 / -1;
            grid-row: 3;

            display: flex;
            flex-direction: row;

            gap: 8px;

            width: 100%;
        }

        .categorie-actions > a,
        .categorie-actions > form {
            flex: 1 1 0;

            width: auto;
            min-width: 0;
        }

        .categorie-actions > a,
        .categorie-actions > form > button {
            width: 100%;
            min-width: 0;
            height: 40px;

            padding: 7px 8px;

            font-size: 13px;
        }
    }


    /* =========================================================
    PETIT MOBILE
    ========================================================= */

    @media screen and (max-width: 420px) {

        .categorie-hero__content {
            padding: 24px 10px 36px;
        }

        .categorie-hero h1 {
            font-size: 23px;
        }

        .categorie-hero .btn-create {
            width: 100%;
        }

        .categorie-content-wrapper {
            padding-left: 8px;
            padding-right: 8px;
        }

        .categorie-card {
            grid-template-columns:
                88px
                minmax(0, 1fr);

            gap: 8px 10px;

            padding: 10px;
        }

        .categorie-image img {
            width: 80px;
            height: 80px;
        }

        .categorie-title a {
            font-size: 16px;
        }

        .categorie-description {
            font-size: 12px;
        }

        .categorie-count {
            font-size: 11px;
        }

        .categorie-actions {
            gap: 6px;
        }

        .categorie-actions > a,
        .categorie-actions > form > button {
            height: 38px;

            padding: 6px;

            font-size: 12px;
        }

        .alphabet-pagination {
            gap: 3px;
        }

        .alphabet-pagination a {
            width: 28px;
            min-width: 28px;
            height: 28px;

            font-size: 11px;
        }

        .alphabet-pagination a:first-child {
            width: auto;
            min-width: 40px;
        }

        .alphabet-pagination a:last-child {
            width: auto;
            min-width: 52px;
        }
    }


    /* =========================================================
    TRÈS PETIT MOBILE
    ========================================================= */

    @media screen and (max-width: 350px) {

        .categorie-card {
            grid-template-columns:
                78px
                minmax(0, 1fr);

            gap: 7px 8px;

            padding: 8px;
        }

        .categorie-image img {
            width: 70px;
            height: 70px;
        }

        .categorie-title a {
            font-size: 15px;
        }

        .categorie-description {
            font-size: 11.5px;
        }

        .categorie-actions > a,
        .categorie-actions > form > button {
            font-size: 11px;
        }
    }


    /* =========================================================
    MOBILE PAYSAGE
    ========================================================= */

    @media screen and (max-height: 500px) and (orientation: landscape) {

        .categorie-hero__content {
            padding-top: 20px;
            padding-bottom: 32px;
        }

        .categorie-hero h1 {
            margin-bottom: 14px;

            font-size: 24px;
        }

        .categorie-content-wrapper {
            padding-top: 14px;
        }
    }
    </style>
    <div class="categorie-page">
        {# =========================================================
            BANDEAU ROUGE
        ========================================================= #}
        <div class="categorie-hero">
            <div class="categorie-hero__content">
                <h1>
                    Liste des catégories
                </h1>
                {% if is_granted('ROLE_ADMIN') %}
                    <a class="btn-create" href="{{ path(
                            'admin.categorie.create'
                        ) }}">
                        Créer une nouvelle catégorie
                    </a>
                {% endif %}
            </div>
            <img class="categorie-hero__bottom" src="/images/top-content-dechire-D.gif" alt=""></div>
            {# =========================================================
                ZONE BLANCHE
            ========================================================= #}
            <div class="categorie-content-wrapper">
                {# =====================================================
                    PAGINATION ALPHABÉTIQUE
                ===================================================== #}
                <nav class="alphabet-pagination" aria-label="Navigation alphabétique">
                    <a href="{{ path(
                        'admin.categorie.index',
                        app.request.query.all|merge({
                            initiale: '0-9',
                            page: 1
                        })
                    ) }}" class="{{ initiale == '0-9'
                            ? 'active'
                            : '' }}">
                        0-9
                    </a>
                    {% for lettre in alphabet %}
                        <a href="{{ path(
                            'admin.categorie.index',
                            app.request.query.all|merge({
                                initiale: lettre,
                                page: 1
                            })
                        ) }}" class="{{ initiale == lettre
                                ? 'active'
                                : '' }}">
                            {{ lettre }}
                        </a>
                    {% endfor %}
                    <a href="{{ path(
                        'admin.categorie.index',
                        app.request.query.all|merge({
                            initiale: null,
                            page: 1
                        })
                    ) }}" class="{{ initiale is empty
                            ? 'active'
                            : '' }}">
                        Toutes
                    </a>
                </nav>
                {# =====================================================
                    PAGINATION KNP HAUTE
                ===================================================== #}
                {% if categories.pageCount > 1 %}
                    <div class="knp-pagination">
                        {{ knp_pagination_render(categories) }}
                    </div>
                {% endif %}
                {# =====================================================
                    CATÉGORIES
                ===================================================== #}
                <article class="categorie-list">
                    {% for row in categories %}
                        {% set categorie = row[0] %}
                        {% set total = row.total %}
                        <section class="
                                categorie-card
                                {{ not categorie.active
                                ? 'categorie-card--inactive'
                                : '' }}
                            ">
                            {# IMAGE #}
                            <div class="categorie-image">
                                {% if categorie.thumbnail %}
                                    <img src="{{ vich_uploader_asset(
                                        categorie,
                                        'thumbnailFile',
                                        'App\\Entity\\Categories'
                                    ) }}" alt="Photo de {{ categorie.titre }}">
                                    {% endif %}
                                </div>
                                {# CONTENU #}
                                <div class="categorie-main">
                                    {% if not categorie.active %}
                                        <div class="categorie-status">
                                            INACTIVE
                                        </div>
                                    {% endif %}
                                    <div class="categorie-title">
                                        <a href="{{ path(
                                        'admin.categorie.show',
                                        {
                                            id: categorie.id
                                        }
                                    ) }}">
                                            {{ categorie.titre }}
                                            -
                                            {% set usernames =
                                        categorie.users
                                            |map(u => u.username)
                                            |join(', ') %}
                                            {% set anciens =
                                        categorie.inviteOldAnimateurs
                                            |filter(
                                                a => a.ancienanimateur
                                            )
                                            |map(a => a ~ '')
                                            |join(', ') %}
                                            {% if usernames %}
                                                {{ usernames }}
                                                {% if anciens %}
                                                    ,
                                                    {{ anciens }}
                                                {% endif %}
                                            {% elseif anciens %}
                                                {{ anciens }}
                                            {% else %}
                                                Utilisateur inconnu
                                            {% endif %}
                                        </a>
                                    </div>
                                    <div class="categorie-description">
                                        {{ categorie.descriptif|raw }}
                                    </div>
                                </div>
                                {# NOMBRE D'ÉMISSIONS #}
                                <div class="categorie-count">
                                    {% if total > 1 %}
                                        {{ total }}
                                        émissions
                                    {% elseif total == 1 %}
                                        1 émission
                                    {% else %}
                                        Aucune émission
                                    {% endif %}
                                </div>
                                {# ACTIONS #}
                                <div class="categorie-actions">
                                    <a href="#" data-controller="return" data-return-url-value="{{ path(
                                    'admin.categorie.edit',
                                    {
                                        id: categorie.id
                                    }
                                ) }}" data-action="
                                            click->return#redirectWithReturnTo
                                        ">
                                        Éditer
                                    </a>
                                    <form action="{{ path(
                                    'admin.categorie.softDelete',
                                    {
                                        id: categorie.id
                                    }
                                ) }}" method="post">
                                        <input type="hidden" name="_method" value="DELETE">
                                            <input type="hidden" name="_token" value="{{ csrf_token(
                                        'delete' ~ categorie.id
                                    ) }}">
                                                <button type="submit" class="btn-action btn-delete">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>
                                    </section>
                                {% endfor %}
                            </article>
                            {# =====================================================
                                PAGINATION KNP BASSE
                            ===================================================== #}
                            {% if categories.pageCount > 1 %}
                                <div class="knp-pagination">
                                    {{ knp_pagination_render(categories) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endblock %}
                