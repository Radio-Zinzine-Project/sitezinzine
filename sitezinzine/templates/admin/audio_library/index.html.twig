{% extends 'admin/admin.html.twig' %}

{% block title %}Bibliothèque MP3{% endblock %}

{% block body %}
    <style>
        .audio-library-home {
            --admin-content-width: var(--admin-width-detail);
            margin-block: 24px;
            padding-bottom: 24px;
            font-family: "Montserrat Alternates", sans-serif;
        }

        .audio-library-home .audio-library-title {
            margin: 0 0 24px;
            font-size: 2rem;
            line-height: 1.2;
            text-align: start;
        }

        .audio-library-home .audio-library-card {
            padding: 24px;
            background: #f9f9f9;
            color: #1c1c1a;
            border-radius: 14px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);
        }

        .audio-library-home .audio-library-links {
            display: grid;
            gap: 12px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .audio-library-home .audio-library-link {
            display: inline-block;
            box-sizing: border-box;
            max-width: 100%;
            padding: 10px 18px;
            border-radius: 999px;
            background: #E4013A;
            color: #fff;
            font-weight: 700;
            overflow-wrap: anywhere;
            text-decoration: none;
        }

        .audio-library-home .audio-library-link:hover,
        .audio-library-home .audio-library-link:focus-visible {
            background: #b8002e;
        }

        .audio-library-home .audio-library-link:focus-visible {
            outline: 2px solid #222;
            outline-offset: 2px;
        }

        @media (max-width: 768px) {
            .audio-library-home {
                margin-block: 20px;
                padding-bottom: 20px;
            }

            .audio-library-home .audio-library-title {
                font-size: 1.45rem;
                text-align: center;
            }

            .audio-library-home .audio-library-card {
                padding: 16px;
            }

            .audio-library-home .audio-library-links {
                text-align: center;
            }

            .audio-library-home .audio-library-link {
                width: 100%;
                max-width: 320px;
            }
        }
    </style>

    <div class="admin-content-gutters">
        <div class="audio-library-home admin-content-container">
            <header>
                <h1 class="audio-library-title">Bibliothèque MP3</h1>
            </header>
            <nav class="audio-library-card" aria-label="Bibliothèque MP3">
                <ul class="audio-library-links" role="list">
                    <li><a class="audio-library-link" href="{{ path('admin.audio_library.inventory.index') }}">Inventaire MP3</a></li>
                    <li><a class="audio-library-link" href="{{ path('admin.audio_library.trash.index') }}">Corbeille MP3</a></li>
                    <li><a class="audio-library-link" href="{{ path('admin.audio_library.cleanup_issues.index') }}">Incidents de nettoyage MP3</a></li>
                </ul>
            </nav>
        </div>
    </div>
{% endblock %}
