{% extends 'admin/admin.html.twig' %}

{% block title %}Incident de nettoyage MP3{% endblock %}

{% block body %}
    {% set statuses = {open: 'Ouvert', investigating: 'En cours', resolved: 'Résolu'} %}
    {% set reasons = {
        reference_check_failed: 'Vérification des références en échec',
        obsolete_cleanup_failed: 'Retrait de l’ancien fichier en échec'
    } %}
    <style>
    .cleanup-page {
        margin-block: 24px;
        padding-bottom: 24px;
        font-family: "Montserrat Alternates", sans-serif;
        overflow-wrap: anywhere;
    }

    .cleanup-page .cleanup-title {
        margin-block: 0 24px;
        font-size: 2rem;
        line-height: 1.2;
        text-align: start;
    }

    .cleanup-page .cleanup-card {
        padding: 24px;
        background: #fff;
        color: #1c1c1a;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);
    }

    .cleanup-page .cleanup-action {
        display: inline-block;
        box-sizing: border-box;
        max-width: 100%;
        padding: 8px 12px;
        border: 0;
        border-radius: 999px;
        background: #222;
        color: #fff;
        font: inherit;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .cleanup-page .cleanup-action:hover {
        background: #000;
    }

    .cleanup-page :focus-visible {
        outline: 2px solid #e4013a;
        outline-offset: 2px;
    }

    .cleanup-page .cleanup-message {
        padding: 14px 16px;
        margin-block: 16px;
        border-radius: 10px;
        background: #f3f3f3;
        color: #333;
    }

    .cleanup-page .cleanup-message[role="alert"] {
        background: #ffebee;
        color: #b71c1c;
    }

    .cleanup-page .cleanup-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        background: #f3f3f3;
        font-weight: 700;
    }

    @media (max-width: 768px) {
        .cleanup-page {
            margin-block: 20px;
            padding-bottom: 20px;
        }

        .cleanup-page .cleanup-title {
            font-size: 1.45rem;
            text-align: center;
        }

        .cleanup-page .cleanup-card {
            padding: 16px;
        }
    }

    .cleanup-page .cleanup-table-scroll {
        overflow-x: auto;
        margin-block: 1rem;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.10);
    }

    .cleanup-page .cleanup-table-scroll:focus-visible {
        outline-offset: -2px;
    }

    .cleanup-page .cleanup-table {
        width: 100%;
        min-width: 780px;
        table-layout: fixed;
        border-collapse: collapse;
    }

    .cleanup-page .cleanup-table caption {
        padding: 12px 16px;
        text-align: start;
    }

    .cleanup-page .cleanup-table th,
    .cleanup-page .cleanup-table td {
        padding: 1rem;
        border-bottom: 1px solid #ddd;
        text-align: start;
        vertical-align: top;
    }

    .cleanup-page .cleanup-table thead th {
        background: #1c1c1a;
        color: #fff;
        font-weight: 800;
    }

    .cleanup-page .cleanup-table tbody tr:nth-child(even) {
        background: #f9f9f9;
    }

    .cleanup-page .cleanup-table tbody tr:hover {
        background: #f5f5f5;
    }

    .cleanup-page .cleanup-pagination {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 16px;
    }


    .cleanup-page {
        margin-top: 0;
    }

    .cleanup-page .cleanup-title {
        margin-top: 24px;
    }

    .cleanup-page .cleanup-attempts,
    .cleanup-page .cleanup-history {
        margin-top: 16px;
    }

    .cleanup-page dt {
        font-weight: 800;
    }

    .cleanup-page dd {
        margin: 4px 0 12px;
    }

    .cleanup-page h2 {
        margin: 0 0 16px;
        font-size: 1.25rem;
        text-align: start;
    }

    .cleanup-page .cleanup-table-scroll--attempts .cleanup-table {
        min-width: 640px;
    }

    .cleanup-page .cleanup-form {
        display: grid;
        gap: 12px;
        margin-top: 16px;
        padding: 16px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: #fafafa;
    }

    .cleanup-page .cleanup-form h3 {
        margin: 0;
        text-align: start;
        font-size: 1.1rem;
    }

    .cleanup-page .cleanup-form label {
        font-weight: 700;
    }

    .cleanup-page .cleanup-check {
        display: flex;
        align-items: start;
        gap: 8px;
    }

    .cleanup-page .cleanup-check input {
        flex: none;
    }

    .cleanup-page .cleanup-form input[type="text"] {
        display: block;
        box-sizing: border-box;
        width: 100%;
        margin-top: 6px;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font: inherit;
    }

    .cleanup-page .cleanup-form button {
        justify-self: start;
    }

    .cleanup-page .cleanup-action--danger {
        background: #c62828;
    }

    .cleanup-page .cleanup-action--danger:hover {
        background: #8e0000;
    }

    .cleanup-page .cleanup-diagnostic {
        margin-block: 16px;
        padding: 14px 16px;
        border: 1px solid #ddd;
        border-radius: 10px;
        background: #f9f9f9;
    }

    .cleanup-page .cleanup-history {
        --admin-width-list: var(--admin-width-list-wide);
        margin-top: 16px;
    }

    .cleanup-page .cleanup-history .cleanup-table {
        min-width: 910px;
    }
    </style>
    <div class="admin-content-gutters">
    <div class="cleanup-page">
    <h1 class="cleanup-title admin-content-container">Incident de nettoyage MP3{% if error is null %} n° {{ detail.issue.id }}{% endif %}</h1>
    <section class="cleanup-card admin-content-container">
        <p><a class="cleanup-action" href="{{ path('admin.audio_library.cleanup_issues.index') }}">Retour aux incidents de nettoyage MP3</a></p>
        {% if error is not null %}
            <p class="cleanup-message" role="alert">{{ error }}</p>
        {% else %}
            {% set issue = detail.issue %}
            <dl>
                <dt>État</dt><dd><span class="cleanup-badge">{{ statuses[issue.status] ?? 'Inconnu' }}</span></dd>
                <dt>Ouvert le</dt><dd>{{ date(issue.created_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') }}</dd>
                {% if issue.resolved_at is not null %}
                    <dt>Résolu le</dt><dd>{{ date(issue.resolved_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') }}</dd>
                {% endif %}
                <dt>Stockage</dt><dd>{{ issue.storage }}</dd>
                <dt>Ancien fichier</dt><dd><code>{{ issue.obsolete_relative_path ?? 'Chemin indisponible' }}</code></dd>
            </dl>
    </section>
    <div class="cleanup-attempts admin-content-container">
            {% include 'admin/audio_library/cleanup_issues/attempts.html.twig' %}
    </div>
    <section class="cleanup-card cleanup-history admin-list-container">
            <h2>Historique des événements</h2>
            {% if detail.events is empty %}
                <p>Aucun événement à afficher.</p>
            {% else %}
                <div class="cleanup-table-scroll" role="region" aria-label="Historique des événements" tabindex="0">
                    <table class="cleanup-table">
                        <thead>
                            <tr>
                                <th scope="col">Événement</th>
                                <th scope="col">Date</th>
                                <th scope="col">Motif</th>
                                <th scope="col">Émission</th>
                                <th scope="col">Fichier de remplacement</th>
                                <th scope="col">Commit confirmé</th>
                                <th scope="col">Références restantes</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for event in detail.events %}
                                <tr>
                                    <td>{{ event.id }}</td>
                                    <td>{{ date(event.occurred_at, 'UTC')|date('d/m/Y H:i', 'Europe/Paris') }}</td>
                                    <td>{{ reasons[event.reason] ?? 'Motif inconnu' }}</td>
                                    <td>{{ event.emission_id }}</td>
                                    <td><code>{{ event.context.replacement_relative_path ?? 'Chemin indisponible' }}</code></td>
                                    <td>{{ event.context.commit_confirmed is same as(true) ? 'Oui' : (event.context.commit_confirmed is same as(false) ? 'Non' : 'Inconnu') }}</td>
                                    <td>{{ event.context.reference_count is same as(null) ? 'Inconnu' : event.context.reference_count }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            {% if hasCursor or detail.pagination.has_more %}
                <nav class="cleanup-pagination" aria-label="Pages de l’historique">
                    {% if hasCursor %}
                        <a class="cleanup-action" href="{{ path('admin.audio_library.cleanup_issues.show', {issueId: issue.id}) }}">Événements récents</a>
                    {% endif %}
                    {% if detail.pagination.has_more %}
                        <a class="cleanup-action" href="{{ path('admin.audio_library.cleanup_issues.show', {issueId: issue.id, last: last, before: detail.pagination.next_before_id}) }}">Événements plus anciens</a>
                    {% endif %}
                </nav>
            {% endif %}
    </section>
        {% endif %}
    </div>
    </div>
{% endblock %}
