{% extends 'admin/admin.html.twig' %}

{% block title %}Incidents de nettoyage MP3{% endblock %}

{% block body %}
    {% set statuses = {open: 'Ouvert', investigating: 'En cours', resolved: 'Résolu'} %}
    <style>
    .cleanup-page {
        margin-block: 24px;
        padding-bottom: 24px;
        font-family: "Montserrat Alternates", sans-serif;
        overflow-wrap: anywhere;
    }

    .cleanup-page .cleanup-title {
        margin-block: 0 24px;
        font-size: 2rem;
        line-height: 1.2;
        text-align: start;
    }

    .cleanup-page .cleanup-card {
        padding: 24px;
        background: #fff;
        color: #1c1c1a;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);
    }

    .cleanup-page .cleanup-action {
        display: inline-block;
        box-sizing: border-box;
        max-width: 100%;
        padding: 8px 12px;
        border: 0;
        border-radius: 999px;
        background: #222;
        color: #fff;
        font: inherit;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .cleanup-page .cleanup-action:hover {
        background: #000;
    }

    .cleanup-page :focus-visible {
        outline: 2px solid #e4013a;
        outline-offset: 2px;
    }

    .cleanup-page .cleanup-message {
        padding: 14px 16px;
        margin-block: 16px;
        border-radius: 10px;
        background: #f3f3f3;
        color: #333;
    }

    .cleanup-page .cleanup-message[role="alert"] {
        background: #ffebee;
        color: #b71c1c;
    }

    .cleanup-page .cleanup-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        background: #f3f3f3;
        font-weight: 700;
    }

    @media (max-width: 768px) {
        .cleanup-page {
            margin-block: 20px;
            padding-bottom: 20px;
        }

        .cleanup-page .cleanup-title {
            font-size: 1.45rem;
            text-align: center;
        }

        .cleanup-page .cleanup-card {
            padding: 16px;
        }
    }

    .cleanup-page .cleanup-table-scroll {
        overflow-x: auto;
        margin-block: 1rem;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.10);
    }

    .cleanup-page .cleanup-table-scroll:focus-visible {
        outline-offset: -2px;
    }

    .cleanup-page .cleanup-table {
        width: 100%;
        min-width: 700px;
        table-layout: fixed;
        border-collapse: collapse;
    }

    .cleanup-page .cleanup-table caption {
        padding: 12px 16px;
        text-align: start;
    }

    .cleanup-page .cleanup-table th,
    .cleanup-page .cleanup-table td {
        padding: 1rem;
        border-bottom: 1px solid #ddd;
        text-align: start;
        vertical-align: top;
    }

    .cleanup-page .cleanup-table thead th {
        background: #1c1c1a;
        color: #fff;
        font-weight: 800;
    }

    .cleanup-page .cleanup-table tbody tr:nth-child(even) {
        background: #f9f9f9;
    }

    .cleanup-page .cleanup-table tbody tr:hover {
        background: #f5f5f5;
    }

    .cleanup-page .cleanup-pagination {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 16px;
    }

    </style>
    <div class="admin-content-gutters">
    <div class="cleanup-page admin-list-container">
    <h1 class="cleanup-title">Incidents de nettoyage MP3</h1>
    <section class="cleanup-card">
        <p><a class="cleanup-action" href="{{ path('admin.audio_library.index') }}">Retour à la bibliothèque MP3</a></p>
        {% if error is not null %}
            <p class="cleanup-message" role="alert">{{ error }}</p>
        {% elseif rows is empty %}
            <p>Aucun incident de nettoyage MP3 à afficher.</p>
        {% else %}
            <div class="cleanup-table-scroll" role="region" aria-label="Incidents de nettoyage MP3" tabindex="0">
                <table class="cleanup-table">
                    <thead>
                        <tr>
                            <th scope="col">Incident</th>
                            <th scope="col">Stockage</th>
                            <th scope="col">Ancien fichier</th>
                            <th scope="col">État</th>
                            <th scope="col">Ouvert le</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td><a class="cleanup-action" href="{{ path('admin.audio_library.cleanup_issues.show', {issueId: row.id}) }}">{{ row.id }}</a></td>
                                <td>{{ row.storage }}</td>
                                <td><code>{{ row.obsolete_relative_path ?? 'Chemin indisponible' }}</code></td>
                                <td><span class="cleanup-badge">{{ statuses[row.status] ?? row.status }}</span></td>
                                <td><time datetime="{{ row.created_at|date('c', 'Europe/Paris') }}">{{ row.created_at|date('d/m/Y H:i', 'Europe/Paris') }}</time></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
        {% if previous or next %}
            <nav class="cleanup-pagination" aria-label="Pages des incidents de nettoyage MP3">
                {% if previous %}<a class="cleanup-action" href="{{ path('admin.audio_library.cleanup_issues.index', {page: previous}) }}">Précédent</a>{% endif %}
                {% if next %}<a class="cleanup-action" href="{{ path('admin.audio_library.cleanup_issues.index', {page: next}) }}">Suivant</a>{% endif %}
            </nav>
        {% endif %}
    </section>
    </div>
    </div>
{% endblock %}
