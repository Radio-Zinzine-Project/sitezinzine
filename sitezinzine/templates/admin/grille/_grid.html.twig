{% set geometry = {
    slotMinutes: 15,
    slotHeight: 14,
    daySlots: 96,
    breakStart: 4,
    breakEnd: 26,
    breakHeight: 28,
} %}
{% set hiddenSlots = geometry.breakEnd - geometry.breakStart %}
{% set breakTop = geometry.breakStart * geometry.slotHeight %}
{% set compression = hiddenSlots * geometry.slotHeight - geometry.breakHeight %}
{% set timeHeight = geometry.daySlots * geometry.slotHeight - compression %}
{% set slotsPerHour = 60 / geometry.slotMinutes %}
{% set indices = range(0, geometry.breakStart - 1)|merge(range(geometry.breakEnd, geometry.daySlots - 1)) %}
{%- macro timePosition(index, breakEnd) -%}
    --time-index:{{ index }};--after-break:{{ index >= breakEnd ? 1 : 0 }};
{%- endmacro -%}
{%- macro timeLabel(index, slotMinutes) -%}
    {%- set minutes = index * slotMinutes -%}
    {{- '%02d:%02d'|format(minutes // 60, minutes % 60) -}}
{%- endmacro -%}
<div class="schedule-grid"
     data-slot-minutes="{{ geometry.slotMinutes }}" data-slot-height="{{ geometry.slotHeight }}"
     data-day-slots="{{ geometry.daySlots }}" data-break-start="{{ geometry.breakStart }}"
     data-break-end="{{ geometry.breakEnd }}" data-break-height="{{ geometry.breakHeight }}"
     style="--slot-h:{{ geometry.slotHeight }}px;--slots-per-hour:{{ slotsPerHour }};--break-top:{{ breakTop }}px;--break-h:{{ geometry.breakHeight }}px;--compression:{{ compression }}px;--time-h:{{ timeHeight }}px;">
    <div class="head hour" style="grid-column:1;grid-row:1;">
        Heure
    </div>
    {% for i in 0..6 %}
        {% set jour = startOfWeek|date_modify("+" ~ i ~ " days") %}
        <div class="head" style="grid-column:{{ 2+i }};grid-row:1;">
            <span class="head__day">
                {{ jour|format_date(pattern='EEEE', locale='fr')|capitalize }}
            </span>
            <span class="head__date">
                {{ jour|date('d/m') }}
            </span>
        </div>
    {% endfor %}
    <div class="hours-col">
        {% for i in indices %}
            <div class="h-slot time-position {{ i % slotsPerHour == 0 ? 'hour-start' : '' }} {{ i % slotsPerHour == slotsPerHour / 2 ? 'half-hour' : '' }}"
                 style="{{ _self.timePosition(i, geometry.breakEnd) }}"></div>
            {% if i % slotsPerHour == 0 %}
                <div class="hour-label time-position" style="{{ _self.timePosition(i, geometry.breakEnd) }}">
                    {{ _self.timeLabel(i, geometry.slotMinutes) }}
                </div>
            {% endif %}
        {% endfor %}
    </div>
    {% for dayIndex in 0..6 %}
        <div class="day-col" data-grid-target="day" data-day-index="{{ dayIndex }}" style="grid-column:{{ 2 + dayIndex }};">
            {% for i in indices %}
                <div class="day-slot time-position {{ i % slotsPerHour == 0 ? 'hour-start' : '' }} {{ i % slotsPerHour == slotsPerHour / 2 ? 'half-hour' : '' }}"
                     data-start-index="{{ i }}" style="{{ _self.timePosition(i, geometry.breakEnd) }}"></div>
            {% endfor %}
            {# Créneaux réguliers #}
            {% for seg in (daySegments[dayIndex] ?? []) %}
                {% set slots = (seg.duration / geometry.slotMinutes)|round(0, 'ceil') %}
                {% set categoryTitle = seg.categoryTitle|default('Catégorie inconnue') %}
                {% set categorySlug = seg.categorySlug|default('') %}
                {% set assignedEmissionTitle = seg.emissionTitle|default('') %}
                {% set broadcastRank = seg.broadcastRank|default(1) %}
                {% set isRebroadcast = broadcastRank > 1 %}
                {% set isLive = seg.emissionIsAutoGenerated|default(false) %}
                {% set isAssigned = seg.assigned|default(false) %}
                {% set displayCategory = isAssigned and categorySlug ? categorySlug : categoryTitle %}
                {% set hasConflict = seg.hasConflict|default(false) %}
                {% set isCancelled = seg.isCancelled|default(false) %}
                {% set canRestore = seg.canRestore|default(false) %}
                {% set isBlocking = seg.isBlocking|default(true) %}
                {% set isRescheduledOrigin = seg.isRescheduledOrigin|default(false) %}
                {% set isProjectedOverride = seg.isProjectedOverride|default(false) %}
                {% set isGhost = isCancelled or isRescheduledOrigin %}
                {#
                    Un ghost recouvert par une émission effective a été rattaché
                    à ce segment par GridViewBuilder.
                    
                    Le post-it reste donc celui de l'émission réellement présente,
                    mais transporte les informations de l'exception pour la sidebar.
                #}
                {% set hasCoveredGhost = seg.hasCoveredGhost|default(false) %}
                {% set coveredGhost = seg.coveredGhost|default(null) %}
                {% set variantClass =
        isGhost
            ? 'postit--ghost'
            : (
                isRebroadcast
                    ? 'postit--rebroadcast'
                    : (
                        isProjectedOverride
                            ? 'postit--rescheduled'
                            : (
                                isLive
                                    ? 'postit--live'
                                    : 'postit--first'
                            )
                    )
            ) %}
                <div class="
                    postit time-position
                    {{ variantClass }}
                    {{ isAssigned ? 'assigned' : '' }}
                    {{ hasConflict ? 'postit--conflict' : '' }}
                    {{ isCancelled ? 'postit--cancelled' : '' }}
                    {{ isRescheduledOrigin ? 'postit--rescheduled-origin' : '' }}
                    {{ not isBlocking ? 'postit--non-blocking' : '' }}
                    {{ hasCoveredGhost ? 'postit--has-exception' : '' }}
                " data-start-index="{{ seg.startIndex }}" style="
                    {{ _self.timePosition(seg.startIndex, geometry.breakEnd) }}
                    height:calc({{ slots }} * var(--slot-h) - 2px);
                " data-segment-key="{{ seg.segmentKey|default('') }}" data-slot-id="{{ seg.slotId|default('') }}" data-draft-id="{{ seg.draftId|default('') }}" data-diffusion-id="{{ seg.diffusionId|default('') }}" data-rule-id="{{ seg.ruleId|default('') }}" data-slots="{{ slots }}" data-duration="{{ seg.duration }}" data-broadcast-rank="{{ broadcastRank }}" data-starts-at="{{ seg.startsAt|default('') }}" data-ends-at="{{ seg.endsAt|default('') }}" data-category-title="{{ categoryTitle }}" data-category-slug="{{ categorySlug }}" data-assigned-emission-id="{{ seg.emissionId|default('') }}" data-assigned-emission-title="{{ assignedEmissionTitle }}" data-emission-is-auto-generated="{{ isLive ? 'true' : 'false' }}" data-slot-locked="{{ isRebroadcast or isGhost ? 'true' : 'false' }}" data-has-conflict="{{ hasConflict ? 'true' : 'false' }}" data-conflict-type="{{ seg.conflictType|default('') }}" data-conflict-severity="{{ seg.conflictSeverity|default('') }}" data-conflict-count="{{ seg.conflictCount|default(0) }}" data-conflict-with="{{ seg.conflictWith|default([])|json_encode|e('html_attr') }}" data-can-reschedule="{{ seg.canBeRescheduled|default(false) ? 'true' : 'false' }}" data-is-projected-override="{{ isProjectedOverride ? 'true' : 'false' }}" data-original-starts-at="{{ seg.originalStartsAt|default('') }}" data-projection-type="{{ seg.projectionType|default('') }}" data-is-cancelled="{{ isCancelled ? 'true' : 'false' }}" data-can-restore="{{ canRestore ? 'true' : 'false' }}" data-is-blocking="{{ isBlocking ? 'true' : 'false' }}" data-is-rescheduled-origin="{{ isRescheduledOrigin ? 'true' : 'false' }}" data-has-covered-ghost="{{ hasCoveredGhost ? 'true' : 'false' }}" data-covered-ghost="{{ coveredGhost ? coveredGhost|json_encode|e('html_attr') : '' }}" data-action="click->grid#selectSlot" draggable="{{ isRebroadcast or isGhost ? 'false' : 'true' }}" {% if isRebroadcast or isGhost %} aria-disabled="true" {% endif %}>
                    <div class="postit__content">
                        {% if slots <= 2 and not isGhost and assignedEmissionTitle %}
                            {# 15 / 30 min : catégorie + titre + rang sur une seule ligne #}
                            <div class="postit__compact-line">
                                <span class="postit__label">
                                    {{ displayCategory|upper }}
                                </span>
                                <span class="postit__compact-title">
                                    {{ assignedEmissionTitle }}
                                </span>
                                <span class="postit__badge">
                                    {% if isRebroadcast %}
                                        ↺ Rediff
                                        {{ broadcastRank - 1 }}
                                    {% elseif isProjectedOverride %}
                                        ⇢ Déplacé
                                    {% elseif isLive %}
                                        ● Direct
                                    {% else %}
                                        1re diff
                                    {% endif %}
                                </span>
                                {% if hasCoveredGhost %}
                                    <span class="postit__exception-badge" title="Une exception de programmation existe sur ce créneau">
                                        ⚠ Exception
                                    </span>
                                {% endif %}
                            </div>
                        {% else %}
                            <div class="postit__topline">
                                <span class="postit__label">
                                    {% if isCancelled %}
                                        Créneau annulé
                                    {% elseif isRescheduledOrigin %}
                                        Créneau déplacé
                                    {% else %}
                                        {{ displayCategory|upper }}
                                    {% endif %}
                                </span>
                                <span class="postit__badge">
                                    {% if isCancelled %}
                                        ↩ Restaurer
                                    {% elseif isRescheduledOrigin %}
                                        ↩ Origine
                                    {% elseif isRebroadcast %}
                                        ↺ Rediff
                                        {{ broadcastRank - 1 }}
                                    {% elseif isProjectedOverride %}
                                        ⇢ Déplacé
                                    {% elseif isLive %}
                                        ● Direct
                                    {% else %}
                                        1re diff
                                    {% endif %}
                                </span>
                            </div>
                            {% if isGhost %}
                                <span class="postit__subline">
                                    Restaurable
                                </span>
                            {% elseif assignedEmissionTitle %}
                                <span class="postit__subline">
                                    {{ assignedEmissionTitle }}
                                </span>
                            {% endif %}
                            {% if hasCoveredGhost %}
                                <span class="postit__exception-badge" title="Une exception de programmation existe sur ce créneau">
                                    ⚠ Exception
                                </span>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
            {# Drafts manuels #}
            {% for draft in (manualDraftsByDay[dayIndex] ?? []) %}
                {% set slots = (draft.duration / geometry.slotMinutes)|round(0, 'ceil') %}
                {% set isManualLive = draft.emissionIsAutoGenerated|default(false) %}
                {% set draftType = draft.draftType|default('') %}
                {% set nombreDiffusion = draft.nombreDiffusion|default(1) %}
                {% set isManualRebroadcast = nombreDiffusion > 1 %}
                {% set draftCategorySlug = draft.categorySlug|default('') %}
                {% set displayDraftCategory = draft.assigned|default(true) and draftCategorySlug ? draftCategorySlug : draft.categoryTitle %}
                <div class="
                    postit time-position
                    {{ isManualRebroadcast ? 'postit--manual-rebroadcast' : (isManualLive ? 'postit--live' : 'postit--override') }}
                    assigned
                " data-start-index="{{ draft.startIndex }}" style="
                    {{ _self.timePosition(draft.startIndex, geometry.breakEnd) }}
                    height:calc({{ slots }} * var(--slot-h) - 2px);
                " data-is-manual-draft="true" data-draft-id="{{ draft.diffusionId|default(null) ? '' : draft.id }}" data-diffusion-id="{{ draft.diffusionId|default('') }}" data-slots="{{ slots }}" data-duration="{{ draft.duration }}" data-starts-at="{{ draft.startsAt }}" data-ends-at="{{ draft.endsAt|default('') }}" data-category-title="{{ draft.categoryTitle }}" data-category-slug="{{ draftCategorySlug }}" data-assigned-emission-id="{{ draft.emissionId|default('') }}" data-assigned-emission-title="{{ draft.title }}" data-emission-is-auto-generated="{{ isManualLive ? 'true' : 'false' }}" data-draft-type="{{ draftType }}" data-nombre-diffusion="{{ nombreDiffusion }}" data-broadcast-rank="{{ nombreDiffusion }}" data-assignment-group-key="{{ draft.assignmentGroupKey|default('') }}" data-slot-locked="false" data-has-conflict="false" data-is-blocking="true" data-action="click->grid#selectSlot">
                    <div class="postit__content">
                        {% if slots <= 2 %}
                            {# 15 / 30 min : catégorie + titre + rang sur une seule ligne #}
                            <div class="postit__compact-line">
                                <span class="postit__label">
                                    {{ displayDraftCategory|upper }}
                                </span>
                                <span class="postit__compact-title">
                                    {{ draft.title }}
                                </span>
                                <span class="postit__badge">
                                    {% if isManualRebroadcast %}
                                        ↺ Rediff
                                        {{ nombreDiffusion - 1 }}
                                    {% elseif isManualLive %}
                                        ● Direct
                                    {% else %}
                                        1re diff
                                    {% endif %}
                                </span>
                            </div>
                        {% else %}
                            <div class="postit__topline">
                                <span class="postit__label">
                                    {{ displayDraftCategory|upper }}
                                </span>
                                <span class="postit__badge">
                                    {% if isManualRebroadcast %}
                                        ↺ Rediff
                                        {{ nombreDiffusion - 1 }}
                                    {% elseif isManualLive %}
                                        ● Direct
                                    {% else %}
                                        1re diff
                                    {% endif %}
                                </span>
                            </div>
                            <span class="postit__subline">
                                {{ draft.title }}
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
    <div class="schedule-break">
        <span class="schedule-break__label">
            {{ _self.timeLabel(geometry.breakStart, geometry.slotMinutes) }} —
            {{ _self.timeLabel(geometry.breakEnd, geometry.slotMinutes) }}
            <span>Plage sans programmation</span>
        </span>
    </div>
</div>
