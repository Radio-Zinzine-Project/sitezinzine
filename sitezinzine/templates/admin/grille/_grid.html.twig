<div class="schedule-grid">
    <div class="head hour" style="grid-column:1;grid-row:1;">
        Heure
    </div>
    {% for i in 0..6 %}
        {% set jour = startOfWeek|date_modify("+" ~ i ~ " days") %}
        <div class="head" style="grid-column:{{ 2+i }};grid-row:1;">
            <span class="head__day">
                {{ jour|format_date(pattern='EEEE', locale='fr')|capitalize }}
            </span>
            <span class="head__date">
                {{ jour|date('d/m') }}
            </span>
        </div>
    {% endfor %}
    <div class="hours-col">
        {% for i in 0..95 %}
            <div class="h-slot
                {{ i %4==0 ? 'hour-start' : '' }}
            {{ i %4==2 ? 'half-hour' : '' }}" style="top:calc({{ i }} * var(--slot-h));"></div>
        {% endfor %}
        {% for h in 0..23 %}
            <div class="hour-label" style="top:calc({{ h*4 }} * var(--slot-h));">
                {{ "%02d:00"|format(h) }}
            </div>
        {% endfor %}
    </div>
    {% for dayIndex in 0..6 %}
        <div class="day-col" data-grid-target="day" data-day-index="{{ dayIndex }}" style="grid-column:{{ 2+dayIndex }};">
            {% for i in 0..95 %}
                <div class="day-slot
                    {{ i%4==0 ? 'hour-start' : '' }}
                {{ i%4==2 ? 'half-hour' : '' }}" style="top:calc({{ i }} * var(--slot-h));"></div>
            {% endfor %}
            {# Créneaux réguliers #}
            {% for seg in (daySegments[dayIndex] ?? []) %}
                {% set slots=(seg.duration/15)|round(0,'ceil') %}
                {% set categoryTitle=seg.categoryTitle|default('Catégorie inconnue') %}
                {% set categorySlug=seg.categorySlug|default('') %}
                {% set displayCategory=seg.duration < 60 and categorySlug ? categorySlug : categoryTitle %}
                {% set assignedEmissionTitle=seg.emissionTitle|default('') %}
                {% set broadcastRank=seg.broadcastRank|default(1) %}
                {% set isRebroadcast=broadcastRank>1 %}
                {% set isLive=seg.emissionIsAutoGenerated|default(false) %}
                {% set isAssigned=seg.assigned|default(false) %}
                {% set hasConflict=seg.hasConflict|default(false) %}
                {% set variantClass =
                    isRebroadcast
                    ? 'postit--rebroadcast'
                    : (
                        isLive
                        ? 'postit--live'
                        : 'postit--first'
                    ) %}
                <div class="
                    postit
                    {{ variantClass }}
                    {{ isAssigned?'assigned':'' }}
                    {{ hasConflict?'postit--conflict':'' }}
                " style="
                    top:calc({{ seg.startIndex }} * var(--slot-h));
                    height:calc({{ slots }} * var(--slot-h) - 2px);
                " data-segment-key="{{ seg.segmentKey|default('') }}" data-slot-id="{{ seg.slotId|default('') }}" data-rule-id="{{ seg.ruleId|default('') }}" data-slots="{{ slots }}" data-duration="{{ seg.duration }}" data-broadcast-rank="{{ broadcastRank }}" data-starts-at="{{ seg.startsAt|default('') }}" data-ends-at="{{ seg.endsAt|default('') }}" data-category-title="{{ categoryTitle }}" data-category-slug="{{ categorySlug }}" data-assigned-emission-id="{{ seg.emissionId|default('') }}" data-assigned-emission-title="{{ assignedEmissionTitle }}" data-emission-is-auto-generated="{{ isLive?'true':'false' }}" data-slot-locked="{{ isRebroadcast?'true':'false' }}" data-has-conflict="{{ hasConflict?'true':'false' }}" data-conflict-type="{{ seg.conflictType|default('') }}" data-conflict-severity="{{ seg.conflictSeverity|default('') }}" data-conflict-count="{{ seg.conflictCount|default(0) }}" data-conflict-with="{{ seg.conflictWith|default([])|json_encode|e('html_attr') }}" data-can-reschedule="{{ seg.canBeRescheduled|default(false)?'true':'false' }}" data-is-projected-override="{{ seg.isProjectedOverride|default(false)?'true':'false' }}" data-original-starts-at="{{ seg.originalStartsAt|default('') }}" data-projection-type="{{ seg.projectionType|default('') }}" data-action="click->grid#selectSlot" draggable="{{ isRebroadcast?'false':'true' }}" {% if isRebroadcast %} aria-disabled="true" {% endif %}>
                    <div class="postit__content">
                        <span class="postit__label">
                            {{ displayCategory|upper }}
                        </span>
                        {% if assignedEmissionTitle %}
                            <span class="postit__subline">
                                {{ assignedEmissionTitle }}
                            </span>
                        {% endif %}
                        {% if slots > 2 %}
                            <span class="postit__badge">
                                {% if isRebroadcast %}
                                    ↺ Rediff
                                    {{ broadcastRank-1 }}
                                {% elseif isLive %}
                                    ● Direct
                                {% else %}
                                    ■ 1re diff
                                {% endif %}
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
            {# Drafts manuels #}
            {% for draft in (manualDraftsByDay[dayIndex] ?? []) %}
                {% set slots=(draft.duration/15)|round(0,'ceil') %}
                {% set isManualLive=draft.emissionIsAutoGenerated|default(false) %}
                {% set draftCategorySlug=draft.categorySlug|default('') %}
                {% set displayDraftCategory=draft.duration < 60 and draftCategorySlug ? draftCategorySlug : draft.categoryTitle %}
                <div class="
                    postit
                    {{ isManualLive ? 'postit--live':'postit--override' }}
                    assigned
                " style="
                    top:calc({{ draft.startIndex }} * var(--slot-h));
                    height:calc({{ slots }} * var(--slot-h)-2px);
                " data-is-manual-draft="true" data-draft-id="{{ draft.id }}" data-slots="{{ slots }}" data-duration="{{ draft.duration }}" data-starts-at="{{ draft.startsAt }}" data-ends-at="{{ draft.endsAt|default('') }}" data-category-title="{{ draft.categoryTitle }}" data-category-slug="{{ draftCategorySlug }}" data-assigned-emission-id="{{ draft.emissionId|default('') }}" data-assigned-emission-title="{{ draft.title }}" data-emission-is-auto-generated="{{ isManualLive?'true':'false' }}" data-slot-locked="false" data-has-conflict="false" data-action="click->grid#selectSlot">
                    <div class="postit__content">
                        <span class="postit__label">
                            {{ displayDraftCategory|upper }}
                        </span>
                        {% if slots>1 %}
                            <span class="postit__subline">
                                {{ draft.title }}
                            </span>
                        {% endif %}
                        {% if slots > 2 and isManualLive %}
                            <span class="postit__badge">
                                ● Direct
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</div>