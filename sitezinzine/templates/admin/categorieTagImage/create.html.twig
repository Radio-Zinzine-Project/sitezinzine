{% extends 'admin/admin.html.twig' %}

{% block title %}Ajouter une image annuelle{% endblock %}

{% block body %}
<div class="admin-content-gutters">
<div class="bodyTagImageCreate admin-content-container">
    <div class="page-header">
        <h1>Ajouter une image annuelle</h1>

        <a href="{{ path('admin_categorieTagImage_index') }}" class="btn-back">
            Retour à la liste
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="flash flash-error">{{ message }}</div>
    {% endfor %}

    {{ include('admin/categorieTagImage/_form.html.twig', {
        form: form,
        button_label: 'Créer'
    }) }}
</div>
</div>

<style>
    .bodyTagImageCreate {
        margin-block: 40px;
        padding-bottom: 40px;
        font-family: "Montserrat Alternates", sans-serif;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .page-header h1 {
        margin: 0;
        font-size: 2rem;
    }

    .btn-back {
        display: inline-block;
        background: #222;
        color: #fff;
        text-decoration: none;
        padding: 10px 18px;
        border-radius: 999px;
        font-weight: 700;
    }

    .btn-back:hover {
        background: #000;
    }

    .flash {
        overflow-wrap: anywhere;
        padding: 14px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .flash-success {
        background: #e8f5e9;
        color: #1b5e20;
    }

    .flash-error {
        background: #ffebee;
        color: #b71c1c;
    }
</style>
{% endblock %}