{% extends 'admin/admin.html.twig' %}

{% block title %}
    Recherche d'émissions
{% endblock %}

{% block body %}

<style>
/* =========================================================
   PAGE
   ========================================================= */

.recherche,
.recherche * {
    box-sizing: border-box;
}

.recherche {
    width: 100%;

    margin: 0;
    padding: 0;

    display: flex;
    flex-direction: column;

    background: linear-gradient(#E4013A, #B81C61);

    font-family: "Montserrat Alternates", sans-serif;
    font-weight: 500;
    font-style: normal;

    overflow-x: hidden;
}

.recherche .top img {
    width: 100%;
}


/* =========================================================
   TYPOGRAPHIE
   ========================================================= */

.recherche strong {
    font-weight: 700 !important;
}

.recherche em {
    font-style: italic !important;
}

.recherche h1 {
    margin: 20px;

    color: white;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 36pt;
    font-weight: 900;
    font-style: normal;
    line-height: 1.15;

    text-align: center;

    overflow-wrap: anywhere;
}

.recherche h2 {
    margin: 10px;

    font-size: 20px;
    text-align: center;
}


/* =========================================================
   CONTENEUR FORMULAIRE
   ========================================================= */

.recherche .form {
    width: 100%;
    max-width: 1200px;

    margin: 0 auto;

    padding: 40px 50px 50px;
}


/* =========================================================
   FORMULAIRE
   ========================================================= */

.recherche .form form {
    width: 100%;
    min-width: 0;

    margin: 0;
    padding: 0;
}


/* =========================================================
   LIGNES DE CHAMPS
   ========================================================= */

.recherche .search-row,
.recherche .date-range {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 20px;

    width: 100%;

    margin-bottom: 20px;
}

.recherche .search-row > div,
.recherche .date-range > div {
    min-width: 0;
}


/* =========================================================
   LABELS
   ========================================================= */

.recherche .form label {
    display: block;

    margin: 0 0 6px;

    color: white;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 16pt;
    font-weight: normal;
    line-height: 1.25;

    overflow-wrap: anywhere;
}


/* =========================================================
   CHAMPS
   ========================================================= */

.recherche .form input[type="text"],
.recherche .form input[type="datetime-local"],
.recherche .form select {
    display: block;

    width: 100%;
    max-width: 100%;
    min-width: 0;

    margin: 8px 0 0;
    padding: 12px 20px;

    background: #fff;
    color: #1C1C1A;

    border: 1px solid #ccc;
    border-radius: 4px;

    font-family: "Montserrat", sans-serif;
    font-size: 15px;
}


/* Flatpickr transforme parfois le champ :
   on garde aussi les inputs générés bien contenus. */

.recherche .form .flatpickr-input,
.recherche .form input.form-control {
    width: 100%;
    max-width: 100%;
    min-width: 0;
}


/* =========================================================
   BOUTONS
   ========================================================= */

.recherche .button-group {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 20px;

    width: 100%;

    margin: 20px 0 0;
}

.recherche .button-group button[type="submit"],
.recherche .button-group button[type="reset"] {
    width: 100%;
    min-width: 0;

    margin: 0;
    padding: 14px 20px;

    border: none;
    border-radius: 4px;

    font-family: "Montserrat Alternates", sans-serif;
    font-size: 16pt;
    font-weight: bold;
    line-height: 1.2;

    cursor: pointer;

    transition:
        background-color .3s ease,
        color .3s ease,
        box-shadow .3s ease,
        border-color .3s ease;
}

.recherche .button-group button[type="submit"] {
    background-color: white;
    color: #E4013A;
}

.recherche .button-group button[type="reset"] {
    background-color: transparent;
    color: white;

    border: 2px solid white;
}

.recherche .button-group button[type="submit"]:hover {
    background-color: #E4013A;
    color: white;

    box-shadow:
        0 4px 8px
        rgba(0, 0, 0, 0.2);
}

.recherche .button-group button[type="reset"]:hover {
    background-color: white;
    color: #E4013A;

    box-shadow:
        0 4px 8px
        rgba(0, 0, 0, 0.2);
}


/* =========================================================
   IMAGE DÉCHIRÉE
   ========================================================= */

.recherche .imgbottom {
    display: block;

    width: 100%;
    height: auto;

    margin: 0;
}


/* =========================================================
   RÉSULTATS / STYLES EXISTANTS
   ========================================================= */

.titre a {
    display: block;

    margin-bottom: 5px;

    color: #E4013A;

    font-size: 20px;
    font-weight: bold;

    text-decoration: none;
}

.titre a:hover {
    color: #B81C61;
}

.cat {
    color: #666;

    font-size: 14px;
    font-style: italic;
}

.descriptif {
    margin: 10px 0;

    color: #333;

    line-height: 1.5;
}

.horaire {
    margin-top: auto;

    color: #666;

    font-size: 14px;
}

.highlight {
    padding: 2px 4px;

    background-color: yellow;
    color: black;

    border-radius: 3px;

    font-weight: bold;
}

.actions-buttons .btn-action {
    display: inline-block;

    padding: 8px 12px;

    background-color: #ccc;
    color: white;

    border: none;
    border-radius: 5px;

    box-sizing: border-box;

    font-size: 14px;
    text-align: center;

    cursor: pointer;
}

.actions-buttons .btn-delete {
    background-color: #E4013A;
}

.actions-buttons .btn-action:hover {
    opacity: 0.9;
}


/* =========================================================
   ÉCRAN INTERMÉDIAIRE / TABLETTE
   ========================================================= */

@media screen and (max-width: 1000px) {

    .recherche .form {
        padding:
            32px
            28px
            42px;
    }

    .recherche .search-row,
    .recherche .date-range {
        gap: 16px;
    }

    .recherche .form label {
        font-size: 15pt;
    }
}


/* =========================================================
   TABLETTE / PETIT ÉCRAN
   ========================================================= */

@media screen and (max-width: 820px) {

    .recherche h1 {
        margin: 18px 16px;

        font-size: 30pt;
    }

    .recherche .form {
        padding:
            24px
            20px
            34px;
    }

    /*
     * On passe à une seule colonne.
     * Cela concerne les DEUX lignes :
     * titre/catégorie/thème
     * et dates/personne.
     */
    .recherche .search-row,
    .recherche .date-range {
        grid-template-columns: 1fr;

        gap: 12px;

        margin-bottom: 12px;
    }

    .recherche .form label {
        font-size: 14pt;
    }

    .recherche .button-group {
        gap: 12px;

        margin-top: 18px;
    }

    .recherche .button-group button[type="submit"],
    .recherche .button-group button[type="reset"] {
        font-size: 14pt;
    }
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

    .recherche h1 {
        margin:
            16px
            12px
            8px;

        font-size: 25pt;
    }

    .recherche .form {
        padding:
            20px
            14px
            30px;
    }

    .recherche .search-row,
    .recherche .date-range {
        gap: 10px;

        margin-bottom: 10px;
    }

    .recherche .form label {
        margin-bottom: 4px;

        font-size: 13pt;
    }

    .recherche .form input[type="text"],
    .recherche .form input[type="datetime-local"],
    .recherche .form select {
        margin-top: 6px;

        padding: 11px 12px;

        font-size: 15px;
    }

    /*
     * Sur téléphone, les boutons sont empilés :
     * beaucoup plus confortable au doigt.
     */
    .recherche .button-group {
        grid-template-columns: 1fr;

        gap: 10px;

        margin-top: 16px;
    }

    .recherche .button-group button[type="submit"],
    .recherche .button-group button[type="reset"] {
        min-height: 48px;

        padding: 12px 14px;

        font-size: 13pt;
    }
}


/* =========================================================
   PETIT MOBILE
   ========================================================= */

@media screen and (max-width: 420px) {

    .recherche h1 {
        margin:
            14px
            10px
            6px;

        font-size: 21pt;
    }

    .recherche .form {
        padding:
            16px
            10px
            26px;
    }

    .recherche .form label {
        font-size: 12.5pt;
    }

    .recherche .form input[type="text"],
    .recherche .form input[type="datetime-local"],
    .recherche .form select {
        padding: 10px;

        font-size: 14px;
    }

    .recherche .button-group button[type="submit"],
    .recherche .button-group button[type="reset"] {
        font-size: 12.5pt;
    }
}


/* =========================================================
   TRÈS PETIT MOBILE
   ========================================================= */

@media screen and (max-width: 350px) {

    .recherche h1 {
        font-size: 19pt;
    }

    .recherche .form {
        padding:
            14px
            8px
            22px;
    }

    .recherche .form input[type="text"],
    .recherche .form input[type="datetime-local"],
    .recherche .form select {
        padding:
            9px
            8px;
    }
}


/* =========================================================
   MOBILE PAYSAGE
   ========================================================= */

@media screen and (max-height: 520px) and (orientation: landscape) {

    .recherche h1 {
        margin:
            10px
            16px
            4px;

        font-size: 22pt;
    }

    .recherche .form {
        padding:
            14px
            18px
            22px;
    }

    /*
     * En paysage, s'il y a assez de largeur,
     * deux colonnes sont plus confortables
     * qu'une longue succession verticale.
     */
    .recherche .search-row,
    .recherche .date-range {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap:
            8px
            14px;
    }

    .recherche .button-group {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .recherche .form label {
        font-size: 12pt;
    }

    .recherche .form input[type="text"],
    .recherche .form input[type="datetime-local"],
    .recherche .form select {
        padding: 9px 10px;
    }
}


/* Sur un paysage vraiment étroit,
   on revient quand même à une seule colonne. */

@media screen and (max-width: 540px)
       and (max-height: 520px)
       and (orientation: landscape) {

    .recherche .search-row,
    .recherche .date-range {
        grid-template-columns: 1fr;
    }
}
</style>


<div class="recherche">

    <h1>
        Recherche d'émissions
    </h1>


    <div
        class="form"
        data-controller="reset-form"
        data-reset-form-url-value="{{ path('admin.emission.rechercheadmin') }}"
    >

        {{ form_start(form) }}


        {# ==================================================
           TITRE / CATÉGORIE / THÈME
           ================================================== #}

        <div class="search-row">

            <div>
                {{ form_row(form.titre) }}
            </div>

            <div>
                {{ form_row(form.categorie) }}
            </div>

            <div>
                {{ form_row(form.theme) }}
            </div>

        </div>


        {# ==================================================
           DATES / PERSONNE
           ================================================== #}

        <div class="date-range">

            <div>
                {{ form_row(form.dateDebut, {
                    attr: {
                        'data-controller': 'flatpickr',
                        'data-flatpickr-date-format-value': 'Y-m-d',
                        'data-flatpickr-alt-format-value': 'd/m/Y'
                    }
                }) }}
            </div>

            <div>
                {{ form_row(form.dateFin, {
                    attr: {
                        'data-controller': 'flatpickr',
                        'data-flatpickr-date-format-value': 'Y-m-d',
                        'data-flatpickr-alt-format-value': 'd/m/Y'
                    }
                }) }}
            </div>

            <div>
                {{ form_row(form.personne) }}
            </div>

        </div>


        {# ==================================================
           ACTIONS
           ================================================== #}

        <div class="button-group">

            <button type="submit">
                Rechercher
            </button>

            <button
                type="reset"
                data-action="reset-form#reset"
            >
                Réinitialiser
            </button>

        </div>


        {{ form_end(form) }}

    </div>


    <img
        class="imgbottom"
        src="/images/top-content-dechire-D.gif"
        alt=""
    >

</div>


<div
    id="resultats"
    tabindex="-1"
></div>


{% include 'partials/_emission_results.html.twig' with {
    emissions: emissions,
    searchTerm: searchTerm,
    showNoResults: form.vars.submitted,
    resultsTitle: 'Résultats de la recherche :',
    noResultsText: 'Aucune émission trouvée pour les critères de recherche.',
    resultsAnchor: 'resultats',
    showRoute: 'admin.emission.show',
    isAdmin: true,
    showAdminActions: true,
    editRoute: 'admin.emission.edit',
    deleteRoute: 'admin.emission.delete',
    useKnpPagination: true,
    useAlphabetPagination: true,
    initiale: initiale,
    alphabet: alphabet,
    alphabetRoute: 'admin.emission.rechercheadmin'
} %}


{% if form.vars.submitted %}

<script>
setTimeout(() => {
    const results = document.getElementById('resultats');

    if (!results) {
        return;
    }

    const url =
        window.location.pathname +
        window.location.search +
        '#resultats';

    window.history.replaceState(
        null,
        '',
        url
    );

    results.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
    });

    results.focus({
        preventScroll: true
    });
}, 100);
</script>

{% endif %}

{% endblock %}