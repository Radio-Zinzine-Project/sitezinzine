{% extends 'base.html.twig' %}
{% block title %}
  Annonces des auditeurices !
{% endblock %}
{% block body %}
  <style>
  .body > .annonces-page {
    flex: 1 0 auto;
  }

  .annonces-page,
  .annonces-page * {
    box-sizing: border-box;
  }

  .annonces-page {
      width: 100%;
      min-width: 0;
      min-height: 100%;
      display: flex;
      flex-direction: column;
      font-family: "Montserrat Alternates", sans-serif;
  }

/* =========================
   DÉCHIRURE ROUGE -> BLANC
   ========================= */

.annonces-hero {
    width: 100%;
    margin: 0;
    padding: 28px 20px 0;
    text-align: center;
    color: #fff;
    overflow: hidden;
}

.annonces-hero .imgbottom {
    display: block;
    width: calc(100% + 40px);
    max-width: none;
    height: auto;

    margin: 40px -20px -1px;
    padding: 0;
}

  .annonces-page-title {
    margin: 0 0 16px;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.05;
    font-weight: 900;
  }

  .annonces-create {
    margin: 0;
  }

  .btn-create-annonce {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 10px 22px;

    background: #fff;
    color: #1c1c1a;

    border: 3px solid #1c1c1a;
    border-radius: 999px;

    text-decoration: none;
    font-size: 15px;
    font-weight: 800;

    box-shadow: 0 8px 20px rgba(0, 0, 0, .22);

    transition:
      transform .2s ease,
      box-shadow .2s ease,
      background .2s ease,
      color .2s ease;
  }

  .btn-create-annonce:hover {
    transform: translateY(-2px);
    background: #f8f1fa;
    color: #E40039;
    box-shadow: 0 12px 26px rgba(0, 0, 0, .28);
  }

  .annonces-tear {
      width: 100%;
      margin: 0;
      padding: 0;
      background: #fff;

      flex: 1 0 auto;
      display: flex;
      flex-direction: column;
  }

  /* =========================
     TRANSITION VERS LE BLANC
     ========================= */

  .annonces-white-zone {
      width: 100%;
      min-width: 0;
      margin: 0;
      padding: 36px 20px 64px;

      background: #fff;
      color: #1c1c1a;

      flex: 1 0 auto;
  }

  .annonces-container {
    width: min(100%, 1400px);
    margin: 0 auto;
  }

  /* =========================
     GRILLE
     ========================= */

  .annonces-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
  }

  /* =========================
     CARTE
     ========================= */

  .annonce-card {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    min-width: 0;
    overflow: hidden;

    background: #fff;
    color: #1c1c1a;

    border: 1px solid #eadff0;
    border-radius: 20px;

    box-shadow: 0 10px 26px rgba(28, 28, 26, .08);

    transition:
      transform .22s ease,
      box-shadow .22s ease,
      border-color .22s ease;
  }

  .annonce-card:hover {
    transform: translateY(-4px);
    border-color: #d8c4e1;
    box-shadow: 0 18px 38px rgba(28, 28, 26, .13);
  }

  .annonce-card--no-image {
    grid-template-columns: minmax(0, 1fr);
}

  /* =========================
     IMAGE
     ========================= */

  .annonce-image {
    width: 150px;
    min-height: 100%;
    background: #f2eef5;
    overflow: hidden;
  }

  .annonce-image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 190px;
    object-fit: cover;
  }

  /* =========================
     CONTENU
     ========================= */

  .annonce-content {
    min-width: 0;
    padding: 20px 22px;
  }

  .annonce-type {
    display: inline-flex;
    align-items: center;
    min-height: 28px;

    margin-bottom: 8px;
    padding: 5px 10px;

    border-radius: 999px;
    background: #f5edf8;
    color: #7E4093;

    font-size: 12px;
    line-height: 1;
    font-weight: 800;
  }

  .annonce-title {
    margin: 0 0 10px;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 900;
  }

  .annonce-title a {
    color: #1c1c1a;
    text-decoration: none;

    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .annonce-title a:hover {
    color: #E40039;
    text-decoration: underline;
  }

  .annonce-meta {
    margin-bottom: 7px;
    color: #5c5660;
    font-size: 14px;
    line-height: 1.4;
  }

  .annonce-dates {
    margin-bottom: 12px;
    color: #7E4093;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 800;
  }

  .annonce-presentation {
    color: #4a454d;
    font-size: 14px;
    line-height: 1.5;

    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;

    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .annonce-presentation p {
    margin-top: 0;
    margin-bottom: 0;
  }

  .annonces-pagination {
    margin-top: 38px;
    display: flex;
    justify-content: center;
}

.annonces-pagination .pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
}

.annonces-pagination .pagination > * {
    list-style: none;
}

.annonces-pagination .pagination a,
.annonces-pagination .pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 38px;
    height: 38px;

    padding: 0 11px;

    border: 1px solid #eadff0;
    border-radius: 999px;

    background: #fff;
    color: #7E4093;

    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
}

.annonces-pagination .pagination a:hover {
    background: #f5edf8;
    border-color: #d8c4e1;
}

.annonces-pagination .pagination .current {
    background: #E40039;
    border-color: #E40039;
    color: #fff;
}



  /* =========================
     RESPONSIVE
     ========================= */

  @media (max-width: 1100px) {
    .annonces-grid {
      grid-template-columns: 1fr;
    }

    .annonce-card {
      grid-template-columns: 170px minmax(0, 1fr);
    }

    .annonce-image {
      width: 170px;
    }
  }

  @media (max-width: 768px) {
    .annonces-hero {
      padding: 22px 16px 0;
    }

    .annonces-hero .imgbottom {
    width: calc(100% + 32px);
    margin: 34px -16px -1px;
    }

    .annonces-white-zone {
        padding: 30px 16px 48px;
    }

    .annonce-card {
      grid-template-columns: 130px minmax(0, 1fr);
      border-radius: 16px;
    }

    .annonce-image {
      width: 130px;
    }

    .annonce-image img {
      min-height: 170px;
    }

    .annonce-content {
      padding: 16px 17px;
    }

    .annonce-title {
      font-size: 18px;
    }

    .annonce-meta,
    .annonce-dates,
    .annonce-presentation {
      font-size: 13px;
    }
  }

  @media (max-width: 560px) {
    .annonces-hero {
        padding: 20px 12px 0;
    }

    .annonces-hero .imgbottom {
    width: calc(100% + 24px);
    margin: 28px -12px -1px;
    }

    .annonces-white-zone {
        padding: 26px 12px 40px;
    }

    .annonce-card {
      grid-template-columns: 1fr;
    }

    .annonce-image {
      width: 100%;
      height: 180px;
    }

    .annonce-image img {
      width: 100%;
      height: 180px;
      min-height: 0;
    }

    .annonce-content {
      padding: 16px;
    }

    .btn-create-annonce {
      width: min(100%, 290px);
      padding-left: 14px;
      padding-right: 14px;
      font-size: 14px;
    }

    .annonces-pagination {
        margin-top: 28px;
    }

    .annonces-pagination .pagination {
        gap: 5px;
    }

    .annonces-pagination .pagination a,
    .annonces-pagination .pagination span {
        min-width: 34px;
        height: 34px;
        padding: 0 9px;
        font-size: 13px;
    }
  }

  @media (max-width: 360px) {
    .annonces-page-title {
      font-size: 25px;
    }

    .annonce-title {
      font-size: 17px;
    }

    .annonce-content {
      padding: 14px;
    }
  }
</style>
  <div class="annonces-page">
    <div class="annonces-hero">
      <h1 class="annonces-page-title">
        Les annonces des auditeurices
      </h1>
      <p class="annonces-create">
        <a class="btn-create-annonce" href="{{ path('annonce.create') }}">
          Créer une nouvelle annonce
        </a>
      </p>
      <img class="imgbottom" src="/images/top-content-dechire-D.gif" alt=""></div>
      <div class="annonces-tear">
        <div class="annonces-white-zone">
          <div class="annonces-container">
            <article class="annonces-grid">
              {% for annonce in annonces %}
                <section class="annonce-card {{ not annonce.thumbnail ? 'annonce-card--no-image' : '' }}">
                  {% if annonce.thumbnail %}
                    <div class="annonce-image">
                      <img src="{{ vich_uploader_asset(annonce, 'thumbnailFile') }}" alt="Photo de {{ annonce.titre }}"></div>
                    {% endif %}
                    <div class="annonce-content">
                      <div class="annonce-type">
                        {{ annonce.type }}
                      </div>
                      <h2 class="annonce-title">
                        <a href="{{ path('annonce.show', { id: annonce.id }) }}">
                          {{ annonce.titre }}
                        </a>
                      </h2>
                      <div class="annonce-meta">
                        <span>
                          {{ annonce.organisateur }}
                        </span>
                        ·
                        <span>
                          {{ annonce.ville }}
                          (
                          {{ annonce.departement }}
                          )
                        </span>
                      </div>
                      <div class="annonce-dates">
                        {% if annonce.dateDebut|date('Y-m-d') == annonce.dateFin|date('Y-m-d') %}
                          {{ annonce.dateDebut|date('d/m/Y') }}
                        {% else %}
                          Du
                          {{ annonce.dateDebut|date('d/m/Y') }}
                          au
                          {{ annonce.dateFin|date('d/m/Y') }}
                        {% endif %}
                        {% if annonce.horaire %}
                          ·
                          {{ annonce.horaire }}
                        {% endif %}
                      </div>
                      <div class="annonce-presentation">
                        {{ annonce.presentation|raw }}
                      </div>
                    </div>
                  </section>
                {% endfor %}
              </article>
              {% if annonces.pageCount > 1 %}
                <div class="annonces-pagination">
                  {{ knp_pagination_render(annonces) }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endblock %}
      