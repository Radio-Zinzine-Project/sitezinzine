# Normalisation automatique des fichiers texte
* text=auto

# Fins de ligne LF pour les fichiers de développement
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.twig text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.sh text eol=lf
.env* text eol=lf
Dockerfile* text eol=lf
dockerfile* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Fins de ligne des scripts Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires : aucune normalisation
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.mp3 binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.ini text eol=lf
*.ps1 text eol=lf
*.timer text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.dist text eol=lf

# Règles de fusion spécifiques aux fichiers de développement
dockerfile.dev merge=ours
docker-compose.dev.yml merge=ours
.env.test merge=ours
compose_old.yaml merge=ours
READMEold.md merge=ours
test.log merge=ours
.phpunit.result.cache merge=ours
# Préservation des fichiers des dépendances tierces
node_modules/** -text !eol
vendor/** -text !eol
